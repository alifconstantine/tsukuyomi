{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "color": {
      "1": "38;2;201;42;42",
      "2": "38;2;234;226;213"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 9
    },
    "color": {
      "keys": "38;2;201;42;42",
      "title": "38;2;234;226;213",
      "separator": "38;2;140;133;122"
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "38;2;127;166;125",
        "yellow": "38;2;199;154;91",
        "red": "38;2;201;42;42"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;title}{user-name}{#}{#separator} @ {#}{#1;title}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;201;42;42m■\u001b[0m \u001b[38;2;140;133;122m■  月読 · Tsukuyomi OS (Arch / CachyOS base)\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;201;42;42m──\u001b[0m \u001b[1;38;2;234;226;213mSYSTEM\u001b[0m \u001b[38;2;58;43;43m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "packages",
      "key": "PKGS"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;201;42;42m──\u001b[0m \u001b[1;38;2;234;226;213mVITALS\u001b[0m \u001b[38;2;58;43;43m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "disk",
      "key": "DISK"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;201;42;42m──\u001b[0m \u001b[1;38;2;234;226;213mSESSION\u001b[0m \u001b[38;2;58;43;43m─────────────────────────────────\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "terminal",
      "key": "TERM"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
