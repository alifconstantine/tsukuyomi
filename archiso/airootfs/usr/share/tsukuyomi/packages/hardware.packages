# Hardware-specific GPU / virtualization packages selected automatically by the installer.

[amd]
mesa
vulkan-radeon
vulkan-icd-loader
lib32-mesa
lib32-vulkan-radeon
lib32-vulkan-icd-loader

[intel]
mesa
vulkan-intel
vulkan-icd-loader
intel-media-driver
lib32-mesa
lib32-vulkan-intel
lib32-vulkan-icd-loader

[nvidia]
nvidia-utils
linux-cachyos-nvidia-open
vulkan-icd-loader
lib32-nvidia-utils
lib32-vulkan-icd-loader

[vm]
mesa
vulkan-virtio
vulkan-icd-loader
lib32-mesa
lib32-vulkan-virtio
lib32-vulkan-icd-loader
qemu-guest-agent
spice-vdagent
