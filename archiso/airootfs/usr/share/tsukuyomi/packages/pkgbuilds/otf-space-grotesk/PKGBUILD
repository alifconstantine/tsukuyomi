# Maintainer: Tsukuyomi OS
# Uses the immutable upstream Space Grotesk v2.0.0 release archive instead of
# AUR's 38c3-styles split PKGBUILD (which requires fontforge + html2markdown).
pkgname=otf-space-grotesk
pkgver=2.0.0
pkgrel=1
pkgdesc="Space Grotesk OTF font for end-4 illogical-impulse"
arch=('any')
url="https://github.com/floriankarsten/space-grotesk"
license=('OFL-1.1')
source=("SpaceGrotesk-${pkgver}.zip::${url}/releases/download/${pkgver}/SpaceGrotesk-${pkgver}.zip")
sha256sums=('53b415577d4139248555300710bea0d268c7a5be67b93de53b716a9736cabffd')

package() {
  install -Dm0644 "${srcdir}/SpaceGrotesk-${pkgver}/otf/"*.otf -t "${pkgdir}/usr/share/fonts/OTF"
  install -Dm0644 "${srcdir}/SpaceGrotesk-${pkgver}/OFL.txt" "${pkgdir}/usr/share/licenses/${pkgname}/OFL.txt"
}
