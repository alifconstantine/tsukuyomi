# Maintainer: Tsukuyomi OS (from end-4/google-sans-flex)
pkgname=ttf-google-sans-flex
pkgver=1.0.0
pkgrel=1
pkgdesc="Google Sans Flex variable font for end-4 illogical-impulse"
arch=('any')
url="https://github.com/end-4/google-sans-flex"
license=('OFL-1.1')
makedepends=('git')
source=("google-sans-flex::git+${url}.git")
sha256sums=('SKIP')

package() {
  cd "$srcdir/google-sans-flex"
  install -Dm0644 "GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf" \
    "$pkgdir/usr/share/fonts/TTF/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf"
  install -Dm0644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
