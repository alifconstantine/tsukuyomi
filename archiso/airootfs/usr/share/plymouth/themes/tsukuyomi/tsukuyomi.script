# Tsukuyomi Plymouth Theme Script
# Pure #000000 framebuffer background with 月読 | TSUKUYOMI wordmark,
# terminal-style status readout, crimson progress bar, and LUKS prompt.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo_x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo_y = Window.GetHeight() / 2 - logo.image.GetHeight() - 28;
if (logo_y < 36) logo_y = 36;
logo.sprite.SetPosition(logo_x, logo_y, 10);
logo.sprite.SetOpacity(1);

initial_mode = Plymouth.GetMode();
global.boot_cmd = "tsukuyomi@boot:~$ systemctl start graphical.target";
global.status_text = "Initializing Tsukuyomi OS...";
if (initial_mode == "shutdown")
  {
    global.boot_cmd = "tsukuyomi@boot:~$ systemctl poweroff";
    global.status_text = "Shutting down Tsukuyomi OS...";
  }
else if (initial_mode == "reboot")
  {
    global.boot_cmd = "tsukuyomi@boot:~$ systemctl reboot";
    global.status_text = "Rebooting Tsukuyomi OS...";
  }
else if (initial_mode == "resume")
  {
    global.boot_cmd = "tsukuyomi@boot:~$ systemctl start hibernate-resume";
    global.status_text = "Resuming session...";
  }

prompt.image = Image.Text(global.boot_cmd, 0.788, 0.165, 0.165);
prompt.sprite = Sprite(prompt.image);
prompt.x = Window.GetWidth() / 2 - prompt.image.GetWidth() / 2;
if (prompt.x < 24) prompt.x = 24;
prompt.y = logo_y + logo.image.GetHeight() + 20;
prompt.sprite.SetPosition(prompt.x, prompt.y, 10);

status.sprite = Sprite();
status.sprite.SetPosition(prompt.x, prompt.y + 34, 10);
progress.sprite = Sprite();
progress.sprite.SetPosition(prompt.x, prompt.y + 68, 10);

global.fake_progress_limit = 0.78;
global.fake_progress_duration = 12.0;

global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0;
global.animation_frame = 0;
global.max_progress = 0.0;
global.last_rendered_pct = -1;
global.last_rendered_status = "";
global.password_dialog_active = 0;
global.password_check_pending = 0;
global.password_error = 0;

fun set_prompt_text(cmd)
  {
    prompt.image = Image.Text(cmd, 0.788, 0.165, 0.165);
    prompt.sprite.SetImage(prompt.image);
    prompt.x = Window.GetWidth() / 2 - prompt.image.GetWidth() / 2;
    if (prompt.x < 24) prompt.x = 24;
    prompt.sprite.SetPosition(prompt.x, prompt.y, 10);
    status.sprite.SetPosition(prompt.x, prompt.y + 34, 10);
    progress.sprite.SetPosition(prompt.x, prompt.y + 68, 10);
  }

fun render_terminal_status()
  {
    if (global.status_text != global.last_rendered_status)
      {
        global.last_rendered_status = global.status_text;
        status.image = Image.Text(global.status_text, 0.918, 0.886, 0.835);
        status.sprite.SetImage(status.image);
        status.sprite.SetPosition(prompt.x, prompt.y + 34, 10);
      }
  }

fun render_terminal_progress(fraction)
  {
    pct = Math.Int(fraction * 100);
    if (pct < 0) pct = 0;
    if (pct > 100) pct = 100;
    if (pct == global.last_rendered_pct)
      return;
    global.last_rendered_pct = pct;

    total_cells = 28;
    filled = Math.Int((pct * total_cells) / 100);
    bar = "[";
    for (i = 0; i < total_cells; i++)
      {
        if (i < filled) bar += "#";
        else bar += "-";
      }
    if (pct < 10)
      bar += "]   " + pct + "%";
    else if (pct < 100)
      bar += "]  " + pct + "%";
    else
      bar += "] " + pct + "%";

    progress.image = Image.Text(bar, 0.788, 0.165, 0.165);
    progress.sprite.SetImage(progress.image);
    progress.sprite.SetPosition(prompt.x, prompt.y + 68, 10);
  }

fun update_progress_bar(progress_val)
  {
    if (progress_val > global.max_progress)
      {
        global.max_progress = progress_val;
        render_terminal_progress(progress_val);
      }
  }

fun show_progress_bar()
  {
    prompt.sprite.SetOpacity(1);
    status.sprite.SetOpacity(1);
    progress.sprite.SetOpacity(1);
    render_terminal_status();
    render_terminal_progress(global.max_progress);
  }

fun hide_progress_bar()
  {
    status.sprite.SetOpacity(0);
    progress.sprite.SetOpacity(0);
  }

fun start_fake_progress()
  {
    if (global.max_progress == 0.0)
      {
        global.fake_progress = 0.0;
        global.real_progress = 0.0;
        update_progress_bar(0.02);
      }
    global.fake_progress_active = 1;
    global.animation_frame = 0;
  }

fun stop_fake_progress()
  {
    global.fake_progress_active = 0;
  }

fun refresh_callback()
  {
    global.animation_frame++;

    if (global.fake_progress_active == 1 && global.password_dialog_active == 0)
      {
        elapsed_time = global.animation_frame / 50.0;
        time_ratio = elapsed_time / global.fake_progress_duration;
        if (time_ratio > 1.0)
          time_ratio = 1.0;

        eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));
        global.fake_progress = eased_ratio * global.fake_progress_limit;
        update_progress_bar(global.fake_progress);
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Password Dialogue --------------------------------

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = prompt.y + 42;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

pwd_status.sprite = Sprite();
pwd_status.sprite.SetOpacity(0);

lock_height = entry.image.GetHeight() * 0.78;
lock_scale = lock_height / 96;
lock_width = 84 * lock_scale;

scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - 14;
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

bullet.sprites = [];

fun update_password_status()
  {
    if (global.password_error == 1)
      pwd_status.image = Image.Text("Wrong passphrase, try again", 0.878, 0.322, 0.322);
    else
      pwd_status.image = Image.Text("Enter the disk passphrase", 0.549, 0.522, 0.478);

    pwd_status.sprite.SetImage(pwd_status.image);
    pwd_status.x = Window.GetWidth() / 2 - pwd_status.image.GetWidth() / 2;
    pwd_status.y = entry.y + entry.image.GetHeight() + 12;
    pwd_status.sprite.SetPosition(pwd_status.x, pwd_status.y, 10001);
    pwd_status.sprite.SetOpacity(1);
  }

fun show_password_dialog()
  {
    set_prompt_text("tsukuyomi@boot:~$ cryptsetup open root");
    lock.sprite.SetOpacity(1);
    entry.sprite.SetOpacity(1);
  }

fun hide_password_dialog()
  {
    lock.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    pwd_status.sprite.SetOpacity(0);
    for (index = 0; bullet.sprites[index]; index++)
      bullet.sprites[index].SetOpacity(0);
    set_prompt_text(global.boot_cmd);
  }

# Show terminal boot readout immediately at boot/resume/shutdown unless LUKS prompts.
if (initial_mode == "boot" || initial_mode == "resume" || initial_mode == "shutdown" || initial_mode == "reboot")
  {
    show_progress_bar();
    start_fake_progress();
  }
else
  {
    hide_progress_bar();
  }

fun display_normal_callback()
  {
    if (global.password_dialog_active == 1)
      {
        global.password_check_pending = 1;
        global.password_dialog_active = 0;
      }

    hide_password_dialog();
    global.last_rendered_status = "";
    global.last_rendered_pct = -1;
    show_progress_bar();
    start_fake_progress();
  }

fun display_password_callback(prompt_str, bullets)
  {
    if (bullets == 0 && global.password_check_pending == 1)
      {
        global.password_error = 1;
        global.password_check_pending = 0;
      }
    else if (bullets > 0)
      global.password_error = 0;

    global.password_dialog_active = 1;

    stop_fake_progress();
    hide_progress_bar();
    global.max_progress = 0.0;
    global.fake_progress = 0.0;
    global.real_progress = 0.0;
    global.last_rendered_pct = -1;
    show_password_dialog();
    update_password_status();

    for (index = 0; bullet.sprites[index]; index++)
      bullet.sprites[index].SetOpacity(0);

    max_bullets = 21;
    bullets_to_show = bullets;
    if (bullets_to_show > max_bullets)
      bullets_to_show = max_bullets;

    for (index = 0; index < bullets_to_show; index++)
      {
        if (!bullet.sprites[index])
          {
            scaled_bullet = bullet.image.Scale(7, 7);
            bullet.sprites[index] = Sprite(scaled_bullet);
            bullet.x = entry.x + 20 + index * (7 + 5);
            bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
            bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
          }
        bullet.sprites[index].SetOpacity(1);
      }
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun progress_callback(duration, progress_val)
  {
    global.real_progress = progress_val;

    if (progress_val > global.fake_progress_limit)
      {
        stop_fake_progress();
        update_progress_bar(progress_val);
      }
  }

Plymouth.SetBootProgressFunction(progress_callback);

fun update_status_callback(text)
  {
    if (global.password_dialog_active == 0 && text != "")
      {
        global.status_text = text;
        render_terminal_status();
      }
  }

Plymouth.SetUpdateStatusFunction(update_status_callback);

fun quit_callback()
  {
    stop_fake_progress();
    update_progress_bar(1.0);
    logo.sprite.SetOpacity(1);
  }

Plymouth.SetQuitFunction(quit_callback);

fun display_message_callback(text)
  {
    if (global.password_dialog_active == 0 && text != "")
      {
        global.status_text = text;
        render_terminal_status();
      }
  }

fun hide_message_callback(text)
  {
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
