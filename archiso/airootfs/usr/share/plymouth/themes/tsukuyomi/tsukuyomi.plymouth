[Plymouth Theme]
Name=Tsukuyomi
Description=Tsukuyomi OS terminal-style boot splash.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/tsukuyomi
ScriptFile=/usr/share/plymouth/themes/tsukuyomi/tsukuyomi.script
ConsoleLogBackgroundColor=0x000000
MonospaceFont=JetBrainsMono Nerd Font 12
Font=JetBrainsMono Nerd Font 12
