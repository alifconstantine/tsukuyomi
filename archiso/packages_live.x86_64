# Tsukuyomi OS live installer ISO packages (Ryoku-style minimal cage + foot + TUI).
# Target desktop packages (Hyprland, Ryoku, SDDM, Plymouth, etc.) are installed
# to /mnt by tsukuyomi-install from /usr/share/tsukuyomi/packages/.

base
linux-cachyos
linux-firmware
mkinitcpio
mkinitcpio-archiso
amd-ucode
intel-ucode
syslinux

# Keyrings & CachyOS mirrors
archlinux-keyring
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
cachyos-v4-mirrorlist

# Installer backend toolchain
arch-install-scripts
parted
gptfdisk
btrfs-progs
dosfstools
cryptsetup
e2fsprogs
ntfs-3g
efibootmgr
limine
reflector
lvm2
mdadm
pciutils

# Networking (nmcli + iwd + wpa_supplicant)
networkmanager
iwd
wpa_supplicant
wireless-regdb
kbd

# Minimal Wayland kiosk + truecolor terminal + Plymouth splash for tsukuyomi-tui
plymouth
mesa
xorg-xwayland
cage
foot
ttf-jetbrains-mono-nerd
otf-ipaexfont

# CLI utilities & diagnostics
git
curl
jq
sudo
less
vim
openssl
fastfetch
