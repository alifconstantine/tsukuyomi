#!/usr/bin/env bash
# Tsukuyomi Fastfetch wrapper with kitty-direct PNG emblem and Tsukuyomi <-> Arch switching.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch"
SYSTEM_DIR="/usr/share/tsukuyomi/fastfetch"

usage() {
  cat <<'EOF'
Usage: tsukuyomi-fetch [OPTIONS] [-- FASTFETCH_ARGS...]

Options:
  -l, --logo <tsukuyomi|arch>         Run fastfetch with the chosen logo once
      --set-default <tsukuyomi|arch>  Persist default logo for plain `fastfetch`
  -h, --help                          Show this help message
EOF
}

resolve_preset() {
  local mode=$1
  local fname="config-${mode}.jsonc"
  if [[ -f "$CONFIG_DIR/$fname" ]]; then
    printf '%s\n' "$CONFIG_DIR/$fname"
  elif [[ -f "$SYSTEM_DIR/$fname" ]]; then
    printf '%s\n' "$SYSTEM_DIR/$fname"
  else
    echo "tsukuyomi-fetch: preset '$mode' not found" >&2
    return 1
  fi
}

resolve_emblem() {
  if [[ -f "$CONFIG_DIR/tsukuyomi-emblem.png" ]]; then
    printf '%s\n' "$CONFIG_DIR/tsukuyomi-emblem.png"
  elif [[ -f "$SYSTEM_DIR/tsukuyomi-emblem.png" ]]; then
    printf '%s\n' "$SYSTEM_DIR/tsukuyomi-emblem.png"
  fi
}

supports_kitty_graphics() {
  [[ -n "${KITTY_WINDOW_ID:-}" || "${TERM:-}" == "xterm-kitty" || "${TERM:-}" == "xterm-ghostty" || "${TERM_PROGRAM:-}" == "ghostty" ]]
}

run_preset() {
  local cfg=$1 mode=${2:-tsukuyomi}
  shift 2
  local emblem="" has_custom_cfg=0 arg
  for arg in "$@"; do
    case "$arg" in
      -c|--config|--config=*) has_custom_cfg=1; break ;;
    esac
  done
  local -a cfg_args=()
  if (( ! has_custom_cfg )); then
    cfg_args=(--config "$cfg")
  fi
  if [[ "$mode" == "tsukuyomi" ]] && supports_kitty_graphics; then
    emblem=$(resolve_emblem || true)
  fi
  if [[ -n "$emblem" ]]; then
    exec fastfetch "${cfg_args[@]}" \
      --logo-type kitty-direct \
      --logo "$emblem" \
      --logo-width 26 \
      --logo-height 13 \
      --logo-padding-top 2 \
      --logo-padding-left 2 \
      --logo-padding-right 4 \
      --pipe false \
      "$@"
  fi
  exec fastfetch "${cfg_args[@]}" "$@"
}

logo_mode=""
set_default=""
extra_args=()

while (($# > 0)); do
  case $1 in
    -l|--logo)
      [[ $# -ge 2 ]] || { echo "tsukuyomi-fetch: $1 requires an argument" >&2; exit 2; }
      logo_mode=$2
      shift 2
      ;;
    --logo=*)
      logo_mode=${1#--logo=}
      shift
      ;;
    --set-default)
      [[ $# -ge 2 ]] || { echo "tsukuyomi-fetch: $1 requires an argument" >&2; exit 2; }
      set_default=$2
      shift 2
      ;;
    --set-default=*)
      set_default=${1#--set-default=}
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      extra_args+=("$@")
      break
      ;;
    *)
      extra_args+=("$1")
      shift
      ;;
  esac
done

if [[ -n $set_default ]]; then
  case $set_default in
    tsukuyomi|arch) ;;
    *) echo "tsukuyomi-fetch: unsupported logo '$set_default' (want tsukuyomi|arch)" >&2; exit 2 ;;
  esac
  mkdir -p "$CONFIG_DIR"
  preset=$(resolve_preset "$set_default")
  cp -f "$preset" "$CONFIG_DIR/config.jsonc"
  echo "Default fastfetch logo set to '$set_default' ($CONFIG_DIR/config.jsonc)"
  exit 0
fi

if [[ -n $logo_mode ]]; then
  case $logo_mode in
    tsukuyomi|arch) ;;
    *) echo "tsukuyomi-fetch: unsupported logo '$logo_mode' (want tsukuyomi|arch)" >&2; exit 2 ;;
  esac
  preset=$(resolve_preset "$logo_mode")
  run_preset "$preset" "$logo_mode" "${extra_args[@]}"
fi

if [[ -f "$CONFIG_DIR/config.jsonc" ]]; then
  active_mode="tsukuyomi"
  if grep -q '"source"[[:space:]]*:[[:space:]]*"arch"' "$CONFIG_DIR/config.jsonc" 2>/dev/null; then
    active_mode="arch"
  fi
  run_preset "$CONFIG_DIR/config.jsonc" "$active_mode" "${extra_args[@]}"
elif [[ -f "$SYSTEM_DIR/config-tsukuyomi.jsonc" ]]; then
  run_preset "$SYSTEM_DIR/config-tsukuyomi.jsonc" "tsukuyomi" "${extra_args[@]}"
else
  exec fastfetch "${extra_args[@]}"
fi
