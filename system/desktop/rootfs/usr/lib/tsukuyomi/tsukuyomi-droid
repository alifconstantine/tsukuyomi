def default_config() -> dict[str, object]:
    return {
        "showSystemApps": False,
        "defaultMode": "phone",
        "phoneSize": "standard",
        "gameResolution": "1280x720",
        "sharedDownloads": False,
        "autoSeedStores": True,
    }


def load_config() -> dict[str, object]:
    cfg = default_config()
    raw = read_json(config_path(), {})
    if isinstance(raw, dict):
        cfg.update({k: v for k, v in raw.items() if k in cfg})
    return cfg


def save_config(cfg: dict[str, object]) -> None:
    atomic_write_json(config_path(), cfg)


def load_apps_db() -> dict[str, dict[str, object]]:
    raw = read_json(apps_db_path(), {})
    return raw if isinstance(raw, dict) else {}


def save_apps_db(db: dict[str, dict[str, object]]) -> None:
    atomic_write_json(apps_db_path(), db)


@contextmanager
def droid_lock() -> Iterator[None]:
    lock_file = xdg_runtime_dir() / "tsukuyomi-droid.lock"
    lock_file.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(lock_file), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def detect_gpu_info() -> dict[str, object]:
    """Detect optimal GPU backend: prefer AMD/Intel/VirtIO Mesa on hybrid, else SwiftShader."""
    sw_marker = False
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if rt and sig and (Path(rt) / "hypr" / sig / "tsukuyomi-software-renderer").is_file():
        sw_marker = True

    vendors: list[str] = []
    preferred_node = ""
    for dev in sorted(Path("/sys/class/drm").glob("renderD*/device/vendor")):
        try:
            v = dev.read_text(encoding="utf-8").strip().lower()
            vendors.append(v)
            if not preferred_node and v in ("0x1002", "0x8086", "0x1af4"):
                node_name = dev.parent.parent.name
                candidate = Path("/dev/dri") / node_name
                if candidate.exists():
                    preferred_node = str(candidate)
        except OSError:
            pass

    has_mesa = any(v in ("0x1002", "0x8086", "0x1af4") for v in vendors)
    has_nvidia = "0x10de" in vendors
    mode = "mesa" if (has_mesa and not sw_marker) else "swiftshader"
    return {
        "mode": mode,
        "vendors": vendors,
        "renderNode": preferred_node if mode == "mesa" else "",
        "hybrid": has_mesa and has_nvidia,
        "softwareRenderer": sw_marker,
    }


def detect_arm_translation() -> dict[str, object]:
    overlay = Path("/var/lib/waydroid/overlay")
    libndk = any(
        (overlay / p).exists()
        for p in (
            "system/lib64/libndk_translation.so",
            "system/lib/libndk_translation.so",
        )
    )
    libhoudini = any(
        (overlay / p).exists()
        for p in (
            "system/lib64/libhoudini.so",
            "system/lib/libhoudini.so",
        )
    )
    return {
        "installed": libndk or libhoudini,
        "libndk": libndk,
        "libhoudini": libhoudini,
    }


def _waydroid_initialized() -> bool:
    return Path("/var/lib/waydroid/waydroid.cfg").is_file()


def _offline_images_present() -> bool:
    for d in (Path("/etc/waydroid-extra/images"), Path("/usr/share/waydroid-extra/images")):
        if (d / "system.img").is_file() and (d / "vendor.img").is_file():
            return True
    return False


def _container_active() -> bool:
    return run_cmd(["systemctl", "is-active", "--quiet", "waydroid-container.service"], timeout=5).returncode == 0


def _session_running() -> bool:
    if not shutil.which("waydroid"):
        return False
    res = run_cmd(["waydroid", "status"], timeout=5)
    return res.returncode == 0 and bool(re.search(r"Session:\s+RUNNING", res.stdout))


def check_status() -> dict[str, object]:
    gpu = detect_gpu_info()
    arm = detect_arm_translation()
    multi_win = True
    if _container_active():
        res = run_cmd(["waydroid", "prop", "get", "persist.waydroid.multi_windows"], timeout=4)
        if res.returncode == 0 and "false" in res.stdout.lower():
            multi_win = False
    return {
        "waydroidAvailable": bool(shutil.which("waydroid")),
        "gamescopeAvailable": bool(shutil.which("gamescope")),
        "initialized": _waydroid_initialized(),
        "offlineImages": _offline_images_present(),
        "containerActive": _container_active(),
        "sessionRunning": _session_running(),
        "multiWindows": multi_win,
        "gpu": gpu,
        "armTranslation": arm,
        "config": load_config(),
    }


def _notify(summary: str, body: str) -> None:
    if shutil.which("notify-send"):
        run_cmd(["notify-send", "-a", "Tsukuyomi DroidBridge", summary, body], timeout=3)


def _waydroid_ip() -> str | None:
    if shutil.which("waydroid"):
        res = run_cmd(["waydroid", "status"], timeout=5)
        if res.returncode == 0:
            m = re.search(r"IP address:\s+([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)", res.stdout)
            if m:
                try:
                    return str(ipaddress.IPv4Address(m.group(1)))
                except ipaddress.AddressValueError:
                    pass
    return None


def _adb_waydroid(*adb_args: str, timeout: int = 15, connect: bool = True) -> subprocess.CompletedProcess[str]:
    """Run an adb command targeted strictly at Waydroid's IP:5555 (never touching USB phones)."""
    if not shutil.which("adb"):
        return subprocess.CompletedProcess(["adb", *adb_args], 127, "", "adb not found")
    address = _waydroid_ip()
    if not address:
        return subprocess.CompletedProcess(["adb", *adb_args], 1, "", "Android has no container IP address yet.")
    target = f"{address}:5555"
    state = run_cmd(["adb", "-s", target, "get-state"], timeout=5)
    if state.returncode != 0 or state.stdout.strip() != "device":
        if not connect:
            return subprocess.CompletedProcess(state.args, 1, "", "Android debugging is not connected.")
        run_cmd(["adb", "connect", target], timeout=8)
    return run_cmd(["adb", "-s", target, *adb_args], timeout=timeout)


def _droid_error(result: subprocess.CompletedProcess[str], fallback: str) -> str:
    detail = result.stderr.strip() or result.stdout.strip()
    low = detail.lower()
    if "device unauthorized" in low or "connection refused" in low or "unable to connect" in low:
        return "Open Android from Tsukuyomi Hub → Compatibility, enable Developer Options → USB debugging and authorize this computer, then try again."
    return detail or fallback


def _droid_failure(message: str) -> int:
    print(json.dumps({"ok": False, "error": message}))
    return 1


def _fit_viewport(width: int, height: int) -> tuple[int, int]:
    monitor = detect_hypr_monitor()
    scale = max(1.0, float(monitor["scale"]))
    factor = min(1.0, int(monitor["width"]) * 0.90 / (scale * width),
                 int(monitor["height"]) * 0.86 / (scale * height))
    return round(width * factor), round(height * factor)


def _phone_viewport(size: str) -> tuple[int, int]:
    width, height = PHONE_VIEWPORTS.get(size, PHONE_VIEWPORTS["standard"])
    monitor = detect_hypr_monitor()
    scale = max(1.0, float(monitor["scale"]))
    res_x = max(0, int(monitor.get("reservedX") or 0))
    res_y = max(0, int(monitor.get("reservedY") or 0))
    avail_w = max(320.0, int(monitor["width"]) / scale - res_x)
    avail_h = max(480.0, int(monitor["height"]) / scale - res_y)
    # Android lays out to the real viewport. Preserve usable text width on short
    # monitors by trimming the viewport height instead of shrinking both axes.
    max_h = round(avail_h * (0.94 if res_y > 0 else 0.86))
    max_w = round(avail_w * 0.90)
    height = min(height, max_h)
    width = min(width, max_w, round(height * 0.80))
    return max(1, width), max(1, height)


def _init_argv() -> list[str]:
    gpu = detect_gpu_info()
    argv = ["pkexec", "/usr/lib/tsukuyomi/droid-system-init", "init", "--gpu", str(gpu["mode"])]
    if gpu.get("renderNode"):
        argv.extend(["--drm-node", str(gpu["renderNode"])])
    phone_size = str(load_config()["phoneSize"])
    if gpu["mode"] == "swiftshader" or phone_size in PHONE_VIEWPORTS:
        width, height = _phone_viewport(phone_size)
        argv.extend(["--viewport", str(width), str(height)])
    return argv


def _ensure_container_ready() -> bool:
    if not _waydroid_initialized():
        if not _offline_images_present():
            raise ValueError("The bundled Android image is missing. Open Tsukuyomi Hub → Compatibility to set up Android.")
        argv = _init_argv() + ["--offline"]
        init_res = run_cmd(argv, timeout=120)
        if init_res.returncode != 0:
            raise ValueError(_droid_error(init_res, "Could not set up Android. Unlock your session and try again."))

    if not _container_active():
        res = run_cmd(["systemctl", "start", "waydroid-container.service"], timeout=15)
        if res.returncode != 0:
            raise ValueError(_droid_error(res, "Could not start the Android service."))
    return True


def _wait_for_session_boot(timeout_sec: float = 60.0) -> bool:
    deadline = time.monotonic() + timeout_sec
    while time.monotonic() < deadline:
        try:
            if _session_running():
                boot = run_cmd(["waydroid", "prop", "get", "sys.boot_completed"], timeout=3)
                if boot.returncode == 0 and boot.stdout.strip() == "1":
                    return True
        except subprocess.TimeoutExpired:
            # The session bus can appear before Android's platform service.
            pass
        time.sleep(0.75)
    return False


def _ensure_container_and_session(*, multi_windows: bool | None = None, width: int = 0, height: int = 0, fake_touch_pkg: str = "") -> bool:
    _ensure_container_ready()

    # Waydroid prop get/set requires an active session; start session first if stopped.
    was_running = _session_running()
    if not was_running:
        subprocess.Popen(
            ["waydroid", "session", "start"], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
        )
    if not _wait_for_session_boot(timeout_sec=15.0 if was_running else 60.0):
        # Recover automatically from a wedged session whose container died/restarted.
        if was_running:
            run_cmd(["waydroid", "session", "stop"], timeout=15)
            run_cmd(["systemctl", "restart", "waydroid-container.service"], timeout=15)
            subprocess.Popen(
                ["waydroid", "session", "start"], stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
            )
            if not _wait_for_session_boot():
                return False
        else:
            return False
    if multi_windows is None:
        return True

    desired_mw = "true" if multi_windows else "false"
    desired_w = str(width) if width > 0 else ""
    desired_h = str(height) if height > 0 else ""

    cur_mw_res = run_cmd(["waydroid", "prop", "get", "persist.waydroid.multi_windows"], timeout=4)
    # Waydroid 1.6.3 defaults unset persist.waydroid.multi_windows to false.
    cur_mw = "true" if (cur_mw_res.returncode == 0 and cur_mw_res.stdout.strip().lower() == "true") else "false"
    cur_w_res = run_cmd(["waydroid", "prop", "get", "persist.waydroid.width"], timeout=4)
    cur_h_res = run_cmd(["waydroid", "prop", "get", "persist.waydroid.height"], timeout=4)
    cur_w = "" if "not set" in cur_w_res.stdout.lower() else cur_w_res.stdout.strip()
    cur_h = "" if "not set" in cur_h_res.stdout.lower() else cur_h_res.stdout.strip()

    need_restart = (cur_mw != desired_mw) or (cur_w != desired_w) or (cur_h != desired_h)

    for key, current, desired in (
        ("multi_windows", cur_mw, desired_mw),
        ("width", cur_w, desired_w),
        ("height", cur_h, desired_h),
    ):
        if current != desired:
            run_cmd(["waydroid", "prop", "set", f"persist.waydroid.{key}", desired], timeout=5)

    if fake_touch_pkg:
        validate_android_pkg(fake_touch_pkg)
        existing_ft = run_cmd(["waydroid", "prop", "get", "persist.waydroid.fake_touch"], timeout=4).stdout.strip()
        if fake_touch_pkg not in existing_ft:
            new_ft = f"{existing_ft},{fake_touch_pkg}.*".strip(",") if existing_ft and "not set" not in existing_ft.lower() else f"{fake_touch_pkg}.*"
            run_cmd(["waydroid", "prop", "set", "persist.waydroid.fake_touch", new_ft], timeout=5)

    if need_restart:
        stopped = run_cmd(["waydroid", "session", "stop"], timeout=15)
        if stopped.returncode != 0:
            return False
        subprocess.Popen(
            ["waydroid", "session", "start"], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
        )
        return _wait_for_session_boot()

    return _session_running()


def _seed_default_stores_if_needed() -> None:
    cfg = load_config()
    if not cfg.get("autoSeedStores", True):
        return
    marker = droid_root() / ".stores-seeded"
    try:
        if marker.read_text(encoding="utf-8").strip() == "2":
            return
    except FileNotFoundError:
        pass
    apks_src = compat_apks_dir()
    if not apks_src.is_dir():
        return
    seeded = True
    for apk_name, package in (("F-Droid.apk", "org.fdroid.fdroid"), ("AuroraStore.apk", "com.aurora.store")):
        apk = apks_src / apk_name
        try:
            installed = run_cmd([PLATFORM, "installed", package], timeout=15)
            if installed.returncode == 0:
                continue
            if not apk.is_file():
                seeded = False
                continue
            res = run_cmd([PLATFORM, "install", str(apk)], timeout=90)
            seeded = seeded and res.returncode == 0
        except subprocess.TimeoutExpired:
            seeded = False
    if seeded:
        atomic_write_text(marker, "2\n")


def _parse_desktop_kv(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    try:
        in_main = False
        for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
            s = line.strip()
            if s.startswith("[") and s.endswith("]"):
                in_main = s == "[Desktop Entry]"
                continue
            if in_main and "=" in s and not s.startswith("#"):
                k, v = s.split("=", 1)
                data[k.strip()] = v.strip()
    except OSError:
        pass
    return data


def sync_desktop() -> dict[str, object]:
    """Normalize Waydroid .desktop files and icons for Tsukuyomi Launcher & Dock."""
    cfg = load_config()
    show_sys = bool(cfg.get("showSystemApps", False))
    db = load_apps_db()
    apps_path = applications_dir()
    apps_path.mkdir(parents=True, exist_ok=True)
    synced: list[str] = []
    desktop_changed = False
    db_changed = False

    for desktop in sorted(apps_path.glob("waydroid.*.desktop")):
        pkg = desktop.stem.removeprefix("waydroid.")
        try:
            validate_android_pkg(pkg)
        except ValueError:
            continue

        kv = _parse_desktop_kv(desktop)
        name = sanitize_desktop_value(kv.get("Name") or pkg.split(".")[-1], pkg)
        hidden = (pkg in SYSTEM_HIDE_PKGS) and (not show_sys)

        # Resolve and normalize icon into hicolor FIRST (before rewriting .desktop)
        icon_name = "application-vnd.android.package-archive"
        icon_candidates = [
            waydroid_icons_dir() / f"{pkg}.png",
            Path(kv.get("Icon", "")) if kv.get("Icon", "").startswith("/") else Path("/nonexistent"),
            icons_hicolor_dir() / f"waydroid.{pkg}.png",
        ]
        for cand in icon_candidates:
            if cand.is_file() and cand.stat().st_size > 0:
                dst = icons_hicolor_dir() / f"waydroid.{pkg}.png"
                if cand != dst and (not dst.is_file() or cand.stat().st_mtime_ns > dst.stat().st_mtime_ns):
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    tmp = dst.with_suffix(".png.tmp")
                    shutil.copyfile(cand, tmp)
                    os.replace(tmp, dst)
                    desktop_changed = True
                icon_name = f"waydroid.{pkg}"
                break

        exec_cmd = format_desktop_exec(["/usr/lib/tsukuyomi/droid-launch", pkg])
        act_phone = format_desktop_exec(["/usr/lib/tsukuyomi/droid-launch", "--mode", "phone", pkg])
        act_game = format_desktop_exec(["/usr/lib/tsukuyomi/droid-launch", "--mode", "game-gamescope", pkg])
        act_stop = format_desktop_exec(["/usr/lib/tsukuyomi/tsukuyomi-droid", "force-stop", pkg])
        act_uninst = format_desktop_exec(["/usr/lib/tsukuyomi/tsukuyomi-droid", "uninstall", pkg])

        content = (
            "[Desktop Entry]\n"
            "Type=Application\n"
            f"Name={name}\n"
            "GenericName=Android App\n"
            f"Comment=Run {name} on Tsukuyomi DroidBridge\n"
            f"Exec={exec_cmd}\n"
            f"Icon={icon_name}\n"
            "Terminal=false\n"
            f"NoDisplay={'true' if hidden else 'false'}\n"
            f"StartupWMClass=waydroid.{pkg}\n"
            "Categories=Utility;X-Tsukuyomi-Android;\n"
            f"Keywords=android;apk;waydroid;{pkg};\n"
            "X-Tsukuyomi-Runtime=android\n"
            f"X-Tsukuyomi-Package={pkg}\n"
            "Actions=LaunchPhone;LaunchGame;ForceStop;Uninstall;\n\n"
            "[Desktop Action LaunchPhone]\n"
            "Name=Open in Phone Mode\n"
            f"Exec={act_phone}\n\n"
            "[Desktop Action LaunchGame]\n"
            "Name=Open in Game Mode (16:9 Landscape)\n"
            f"Exec={act_game}\n\n"
            "[Desktop Action ForceStop]\n"
            "Name=Force Stop Android App\n"
            f"Exec={act_stop}\n\n"
            "[Desktop Action Uninstall]\n"
            "Name=Uninstall Android App\n"
            f"Exec={act_uninst}\n"
        )
        try:
            old_content = desktop.read_text(encoding="utf-8", errors="replace")
        except FileNotFoundError:
            continue
        if old_content != content:
            atomic_write_text(desktop, content)
            desktop_changed = True

        if pkg not in db:
            db[pkg] = {
                "package": pkg,
                "name": name,
                "mode": cfg["defaultMode"],
                "fakeTouch": False,
                "system": pkg in SYSTEM_HIDE_PKGS,
            }
            db_changed = True
        elif db[pkg].get("name") != name:
            db[pkg]["name"] = name
            db_changed = True
        synced.append(pkg)

    if db_changed:
        save_apps_db(db)
    if desktop_changed:
        refresh_desktop_caches()
    return {"ok": True, "synced": synced}


def cmd_init(args: argparse.Namespace) -> int:
    with droid_lock():
        argv = _init_argv()
        if args.offline or _offline_images_present():
            argv.append("--offline")
        if args.gapps:
            argv.append("--gapps")
        if args.force:
            argv.append("--force")
        res = run_cmd(argv, timeout=300)
        if res.returncode != 0:
            print(json.dumps({"ok": False, "error": res.stderr.strip() or res.stdout.strip()}))
            return 1
        if not _ensure_container_and_session():
            return _droid_failure("Android did not finish starting. Try again from Compatibility.")
        _seed_default_stores_if_needed()
        sync_desktop()
        print(json.dumps({"ok": True, "status": check_status()}))
        return 0


def cmd_install(args: argparse.Namespace) -> int:
    src = Path(args.file).expanduser().resolve()
    if not src.is_file():
        print(json.dumps({"ok": False, "error": f"File not found: {src}"}))
        return 1

    meta = inspect_android_package(src)
    if meta.get("error"):
        print(json.dumps({"ok": False, "error": str(meta["error"])}))
        return 1
    pkg = validate_android_pkg(str(meta.get("package") or ""))
    if meta["needs_arm_translation"] and not detect_arm_translation()["installed"]:
        return _droid_failure("This app requires ARM support. Install ARM translation from the installer or Tsukuyomi Hub, then try again.")

    with droid_lock():
        if not _ensure_container_and_session():
            return _droid_failure("Android did not finish starting. Try again from Compatibility.")

        if src.suffix.lower() in (".xapk", ".apkm"):
            with tempfile.TemporaryDirectory(prefix="tsukuyomi-xapk-inst-") as tmp:
                extracted = safe_extract_zip(src, Path(tmp), allowed_exts={".apk", ".obb"})
                apks = sorted(str(p) for p in extracted if p.suffix.lower() == ".apk")
                if not apks:
                    return _droid_failure("This bundle contains no Android app package.")
                obbs = [p for p in extracted if p.suffix.lower() == ".obb"]
                if any(not re.fullmatch(rf"(?:main|patch)\.\d+\.{re.escape(pkg)}\.obb", p.name) for p in obbs):
                    return _droid_failure("This bundle contains expansion files for a different Android package.")
                res = _adb_waydroid("install-multiple", "-r", *apks, timeout=180)
                if res.returncode != 0 or "Success" not in res.stdout.splitlines():
                    return _droid_failure(_droid_error(res, "Android rejected the package."))
                if obbs:
                    destination = f"/sdcard/Android/obb/{pkg}"
                    mkdir = _adb_waydroid("shell", "mkdir", "-p", destination)
                    if mkdir.returncode != 0:
                        return _droid_failure(_droid_error(mkdir, "The app installed, but its expansion files could not be written."))
                    for obb in obbs:
                        push = _adb_waydroid("push", str(obb), f"{destination}/{obb.name}", timeout=180)
                        if push.returncode != 0:
                            return _droid_failure(_droid_error(push, "The app installed, but its expansion files could not be copied."))
        else:
            res = run_cmd([PLATFORM, "install", str(src)], timeout=180)
            if res.returncode != 0:
                return _droid_failure(_droid_error(res, "Android rejected the package."))

        db = load_apps_db()
        mode = args.mode or db.get(pkg, {}).get("mode") or load_config()["defaultMode"]
        db[pkg] = {
            "package": pkg,
            "name": str(meta.get("name") or pkg),
            "mode": mode,
            "fakeTouch": mode in ("landscape", "game-gamescope"),
            "system": pkg in SYSTEM_HIDE_PKGS,
        }
        save_apps_db(db)

        _seed_default_stores_if_needed()
        desktop = applications_dir() / f"waydroid.{pkg}.desktop"
        deadline = time.monotonic() + 5
        while not desktop.is_file() and time.monotonic() < deadline:
            time.sleep(0.25)
        synced = sync_desktop()["synced"]
        launcher_ready = pkg in synced and _parse_desktop_kv(desktop).get("NoDisplay") != "true"
        print(json.dumps({"ok": True, "package": pkg, "name": meta.get("name"), "launcherReady": launcher_ready}))
        return 0


def cmd_launch(args: argparse.Namespace) -> int:
    pkg = validate_android_pkg(args.package)
    db = load_apps_db()
    cfg = load_config()
    rec = db.get(pkg, {})
    mode = args.mode or str(rec.get("mode") or cfg.get("defaultMode") or "phone")
    software = detect_gpu_info()["mode"] == "swiftshader"

    with droid_lock():
        if mode == "game-gamescope":
            res_str = str(cfg.get("gameResolution") or "1280x720")
            try:
                w_str, h_str = res_str.lower().split("x", 1)
                w, h = int(w_str), int(h_str)
            except ValueError:
                w, h = 1280, 720
            if shutil.which("gamescope") and not software:
                _ensure_container_ready()
                # Stop host-bound session first so Waydroid binds to gamescope's WAYLAND_DISPLAY!
                if _session_running():
                    if run_cmd(["waydroid", "session", "stop"], timeout=15).returncode != 0:
                        return 1
                game = subprocess.Popen(
                    [
                        "gamescope", "--expose-wayland",
                        "-w", str(w), "-h", str(h),
                        "-W", str(w), "-H", str(h),
                        "-S", "fit", "--",
                        "/usr/lib/tsukuyomi/droid-gamescope-entry", pkg, str(w), str(h),
                    ],
                    shell=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                try:
                    game.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    return 0
                return 1
            w, h = _fit_viewport(w, h)
            if not _ensure_container_and_session(multi_windows=False, width=w, height=h, fake_touch_pkg=pkg):
                return 1
            return run_cmd(["waydroid", "app", "launch", pkg], timeout=20).returncode

        # SwiftShader and explicit phone sizes use a real Android viewport.
        # Resizing a freeform Waydroid frame can leave the app at its old size.
        phone_size = str(cfg["phoneSize"])
        single_viewport = software or (mode == "phone" and phone_size in PHONE_VIEWPORTS)
        if mode == "landscape":
            w, h = _fit_viewport(1280, 720)
        elif single_viewport:
            w, h = _phone_viewport(phone_size)
        else:
            w, h = 0, 0
        ft_pkg = pkg if (mode == "landscape" or rec.get("fakeTouch")) else ""
        if not _ensure_container_and_session(multi_windows=not single_viewport, width=w, height=h, fake_touch_pkg=ft_pkg):
            return 1
        res = run_cmd(["waydroid", "app", "launch", pkg], timeout=20)
        return res.returncode


def cmd_gamescope_session(args: argparse.Namespace) -> int:
    pkg = validate_android_pkg(args.package)
    display = os.environ.get("WAYLAND_DISPLAY")
    if not display:
        return 1

    def owns_session() -> bool:
        status = run_cmd(["waydroid", "status"], timeout=5)
        return any(line.partition(":")[2].strip() == display
                   for line in status.stdout.splitlines() if line.startswith("Wayland display:"))

    def stop(_signum: int, _frame: object) -> None:
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        gw, gh = _fit_viewport(args.width, args.height)
        with droid_lock():
            if not _ensure_container_and_session(
                multi_windows=False, width=gw, height=gh, fake_touch_pkg=pkg,
            ) or not owns_session():
                return 1
            _adb_waydroid("shell", "wm", "user-rotation", "lock", "1", timeout=5, connect=False)
            launched = run_cmd(["waydroid", "app", "launch", pkg], timeout=20)
            if launched.returncode != 0:
                return launched.returncode
        # Gamescope stays up for the lifetime of its child command.
        while owns_session():
            time.sleep(2.5)
        return 0
    finally:
        if owns_session():
            run_cmd(["waydroid", "session", "stop"], timeout=15)


def cmd_resize(args: argparse.Namespace) -> int:
    preset = args.preset
    if preset == "reset":
        for prop in ("size", "density"):
            result = _adb_waydroid("shell", "wm", prop, "reset", timeout=5)
            if result.returncode != 0:
                return _droid_failure(_droid_error(result, "Unable to reset the Android window."))
        print(json.dumps({"ok": True, "preset": "reset"}))
        return 0

    w, h, dpi = VIEWPORT_PRESETS[preset]
    win_w, win_h = _fit_viewport(w, h)

    resized = False
    if shutil.which("hyprctl"):
        window = run_cmd(["hyprctl", "activewindow", "-j"], timeout=3)
        if window.returncode == 0:
            try:
                cls = str(json.loads(window.stdout).get("class") or "").lower()
                if cls.startswith("waydroid.") or cls == "waydroid":
                    geometry = f"hl.dsp.window.resize({{x = {win_w}, y = {win_h}}})"
                    result = run_cmd(["hyprctl", "dispatch", geometry], timeout=3)
                    resized = result.returncode == 0 and result.stdout.strip() == "ok"
                    if resized:
                        run_cmd(["hyprctl", "dispatch", "hl.dsp.window.center()"], timeout=3)
            except (ValueError, AttributeError):
                pass
    if not resized:
        for prop, value in (("size", f"{w}x{h}"), ("density", str(dpi))):
            result = _adb_waydroid("shell", "wm", prop, value, timeout=5, connect=False)
            if result.returncode != 0:
                return _droid_failure("Focus an Android app window before changing its size.")
    print(json.dumps({"ok": True, "preset": preset, "width": win_w, "height": win_h}))
    return 0


def cmd_sleep(_args: argparse.Namespace) -> int:
    with droid_lock():
        run_cmd(["waydroid", "session", "stop"], timeout=15)
        res = run_cmd(["systemctl", "stop", "waydroid-container.service"], timeout=15)
        print(json.dumps({"ok": res.returncode == 0}))
        return 0 if res.returncode == 0 else 1


def cmd_uninstall(args: argparse.Namespace) -> int:
    pkg = validate_android_pkg(args.package)
    with droid_lock():
        if not _ensure_container_and_session():
            return _droid_failure("Android did not finish starting. Try again from Compatibility.")
        res = run_cmd([PLATFORM, "remove", pkg], timeout=85)
        if res.returncode != 0:
            return _droid_failure(_droid_error(res, "Android could not remove the app."))
        (applications_dir() / f"waydroid.{pkg}.desktop").unlink(missing_ok=True)
        (icons_hicolor_dir() / f"waydroid.{pkg}.png").unlink(missing_ok=True)
        db = load_apps_db()
        db.pop(pkg, None)
        save_apps_db(db)
        refresh_desktop_caches()
        print(json.dumps({"ok": True, "removed": pkg}))
        return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="tsukuyomi-droid")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status")
    sub.add_parser("sync-desktop")
    sub.add_parser("list")
    sub.add_parser("sleep")
    sub.add_parser("open-ui")

    p_init = sub.add_parser("init")
    p_init.add_argument("--offline", action="store_true")
    p_init.add_argument("--gapps", action="store_true")
    p_init.add_argument("--force", action="store_true")

    p_ins = sub.add_parser("inspect")
    p_ins.add_argument("file")

    p_inst = sub.add_parser("install")
    p_inst.add_argument("file")
    p_inst.add_argument("--mode", choices=("phone", "landscape", "game-gamescope"))

    p_launch = sub.add_parser("launch")
    p_launch.add_argument("package")
    p_launch.add_argument("--mode", choices=("phone", "landscape", "game-gamescope", ""), default="")

    p_game = sub.add_parser("gamescope-session")
    p_game.add_argument("package")
    p_game.add_argument("width", type=int)
    p_game.add_argument("height", type=int)

    p_res = sub.add_parser("resize")
    p_res.add_argument("preset", choices=("compact", "phone", "tablet", "landscape", "fullhd", "reset"))

    p_prof = sub.add_parser("set-profile")
    p_prof.add_argument("package")
    p_prof.add_argument("--mode", choices=("phone", "landscape", "game-gamescope"), required=True)

    p_stop = sub.add_parser("force-stop")
    p_stop.add_argument("package")

    p_un = sub.add_parser("uninstall")
    p_un.add_argument("package")

    p_add = sub.add_parser("setup-addon")
    p_add.add_argument("addon", choices=("libndk", "libhoudini", "gapps"))

    p_cfg = sub.add_parser("set-config")
    p_cfg.add_argument("--show-system-apps", choices=("true", "false"), default="")
    p_cfg.add_argument("--game-resolution", default="")
    p_cfg.add_argument("--phone-size", choices=("auto", *PHONE_VIEWPORTS))
    p_cfg.add_argument("--shared-downloads", choices=("true", "false"), default="")

    args = parser.parse_args(argv)
    if args.cmd == "status":
        print(json.dumps(check_status()))
        return 0
    if args.cmd == "inspect":
        src = Path(args.file).expanduser().resolve()
        icon_tmp = xdg_runtime_dir() / f"tsukuyomi-droid-preview-{os.getpid()}.png"
        icon_tmp.unlink(missing_ok=True)
        info = inspect_android_package(src, icon_tmp)
        if not info.get("icon_extracted"):
            icon_tmp.unlink(missing_ok=True)
            info["icon_preview"] = ""
        else:
            info["icon_preview"] = str(icon_tmp)
        info["arm_translation_installed"] = bool(detect_arm_translation()["installed"])
        print(json.dumps(info))
        return 0
    if args.cmd == "init":
        return cmd_init(args)
    if args.cmd == "install":
        return cmd_install(args)
    if args.cmd == "launch":
        return cmd_launch(args)
    if args.cmd == "gamescope-session":
        return cmd_gamescope_session(args)
    if args.cmd == "resize":
        return cmd_resize(args)
    if args.cmd == "sleep":
        return cmd_sleep(args)
    if args.cmd == "open-ui":
        with droid_lock():
            cfg = load_config()
            phone_size = str(cfg["phoneSize"])
            w, h = _phone_viewport(phone_size) if phone_size in PHONE_VIEWPORTS else (0, 0)
            if _ensure_container_and_session(multi_windows=False, width=w, height=h):
                _seed_default_stores_if_needed()
                subprocess.Popen(["waydroid", "show-full-ui"], shell=False)
                return 0
            return 1
    if args.cmd == "sync-desktop":
        with droid_lock():
            print(json.dumps(sync_desktop()))
        return 0
    if args.cmd == "list":
        print(json.dumps({"apps": list(load_apps_db().values()), "config": load_config()}))
        return 0
    if args.cmd == "set-profile":
        pkg = validate_android_pkg(args.package)
        with droid_lock():
            db = load_apps_db()
            rec = db.get(pkg, {"package": pkg, "name": pkg, "system": pkg in SYSTEM_HIDE_PKGS})
            rec["mode"] = args.mode
            rec["fakeTouch"] = args.mode in ("landscape", "game-gamescope")
            db[pkg] = rec
            save_apps_db(db)
        print(json.dumps({"ok": True, "app": rec}))
        return 0
    if args.cmd == "force-stop":
        pkg = validate_android_pkg(args.package)
        res = _adb_waydroid("shell", "am", "force-stop", pkg, timeout=10)
        return res.returncode
    if args.cmd == "uninstall":
        return cmd_uninstall(args)
    if args.cmd == "setup-addon":
        # Stream live output so interactive terminal shows progress clearly.
        res = subprocess.run(["pkexec", "/usr/lib/tsukuyomi/droid-system-init", "addon", args.addon], shell=False)
        return res.returncode
    if args.cmd == "set-config":
        cfg = load_config()
        if args.show_system_apps:
            cfg["showSystemApps"] = args.show_system_apps == "true"
        if args.game_resolution and "x" in args.game_resolution:
            cfg["gameResolution"] = args.game_resolution
        if args.phone_size:
            cfg["phoneSize"] = args.phone_size
        if args.shared_downloads:
            enable = args.shared_downloads == "true"
            user = os.environ.get("USER") or Path.home().name
            res = run_cmd(
                ["pkexec", "/usr/lib/tsukuyomi/droid-system-init", "bind-shared", "--user", user, "--uid", str(os.getuid()), "--enable", args.shared_downloads],
                timeout=30,
            )
            if res.returncode == 0:
                cfg["sharedDownloads"] = enable
        save_config(cfg)
        sync_desktop()
        print(json.dumps({"ok": True, "config": cfg}))
        return 0
    return 1


if __name__ == "__main__":
    try:
        result = main(sys.argv[1:])
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        result = _droid_failure(str(exc))
    if result != 0 and sys.argv[1:2] in (["launch"], ["gamescope-session"]):
        _notify("Android app could not open", "Check Android status in Tsukuyomi Hub → Compatibility.")
    sys.exit(result)
