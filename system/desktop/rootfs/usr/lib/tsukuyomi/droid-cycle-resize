#!/usr/bin/env bash
set -euo pipefail

force=false
if [[ ${1:-} == "--force" ]]; then
    force=true
fi

if ! $force; then
    # Only cycle Android viewport preset when an active Waydroid window is focused.
    active_class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""' || true)
    case "${active_class,,}" in
        waydroid.*|waydroid) ;;
        *) exit 0 ;;
    esac
fi

state_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_file="$state_dir/tsukuyomi-droid-viewport-idx"
presets=(phone tablet landscape compact)
idx=0
if [[ -r $state_file ]]; then
    idx=$(cat "$state_file" 2>/dev/null || echo 0)
    [[ $idx =~ ^[0-9]+$ ]] || idx=0
fi
next=$(( (idx + 1) % ${#presets[@]} ))
preset="${presets[$next]}"
printf '%s\n' "$next" > "$state_file"

/usr/lib/tsukuyomi/tsukuyomi-droid resize "$preset" >/dev/null 2>&1 || true
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Tsukuyomi DroidBridge" -t 1600 "Android Viewport" "Switched to $preset" || true
fi
