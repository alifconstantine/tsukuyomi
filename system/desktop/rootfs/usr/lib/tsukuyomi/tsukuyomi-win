def win_root() -> Path:
    return xdg_data_home() / "tsukuyomi" / "windows"


def prefixes_dir() -> Path:
    return win_root() / "prefixes"


def apps_dir() -> Path:
    return win_root() / "apps"


def config_path() -> Path:
    return win_root() / "config.json"


def shared_dir() -> Path:
    return Path.home() / "Public" / "Tsukuyomi-Windows"


def icons_hicolor_dir() -> Path:
    return xdg_data_home() / "icons" / "hicolor" / "256x256" / "apps"


def applications_dir() -> Path:
    return xdg_data_home() / "applications"


def default_config() -> dict[str, object]:
    return {
        "defaultRunner": "wine",
        "defaultWayland": False,
        "defaultSandbox": True,
        "defaultDxvk": True,
        "defaultWindowsVersion": "win10",
    }


def load_config() -> dict[str, object]:
    cfg = default_config()
    raw = read_json(config_path(), {})
    if isinstance(raw, dict):
        cfg.update({k: v for k, v in raw.items() if k in cfg})
    return cfg


def save_config(cfg: dict[str, object]) -> None:
    atomic_write_json(config_path(), cfg)


def check_status() -> dict[str, object]:
    wine_ver = ""
    if shutil.which("wine"):
        res = run_cmd(["wine", "--version"], timeout=5)
        if res.returncode == 0:
            wine_ver = res.stdout.strip()
    proton_paths = [
        p
        for p in (
            "/usr/share/steam/compatibilitytools.d/proton-cachyos",
            "/usr/share/steam/compatibilitytools.d/proton-cachyos-slr",
        )
        if Path(p).is_dir()
    ]
    ntsync_available = Path("/dev/ntsync").exists() or Path("/sys/module/ntsync").exists()
    return {
        "wineAvailable": bool(shutil.which("wine")),
        "wineVersion": wine_ver,
        "umuAvailable": bool(shutil.which("umu-run")),
        "protonPaths": proton_paths,
        "protonAvailable": bool(proton_paths),
        "dxvkAvailable": Path("/usr/share/dxvk").is_dir() or bool(shutil.which("setup_dxvk")),
        "vkd3dAvailable": Path("/usr/share/vkd3d-proton").is_dir() or Path("/usr/lib/vkd3d").is_dir(),
        "winetricksAvailable": bool(shutil.which("winetricks")),
        "bwrapAvailable": bool(shutil.which("bwrap")),
        "ntsyncAvailable": ntsync_available,
        "config": load_config(),
    }


def _wine_env(
    prefix: Path, *, wayland: bool = False, dxvk: bool = True,
    runner: str = "wine", headless: bool = False,
) -> dict[str, str]:
    env = os.environ.copy()
    env["WINEPREFIX"] = str(prefix)
    env["WINEARCH"] = "win64"
    env["WINEDEBUG"] = env.get("WINEDEBUG", "-all")
    env["WINE_NTSYNC"] = "1"
    overrides = ["winemenubuilder.exe=d"]
    if dxvk:
        overrides.append("d3d9,d3d10core,d3d11,dxgi,d3d12,d3d12core=n,b")
    else:
        overrides.append("d3d9,d3d10core,d3d11,dxgi,d3d12,d3d12core=b")
    for directory, dll in (("mono", "mscoree"), ("gecko", "mshtml")):
        if not any(Path("/usr/share/wine", directory).glob("*")):
            overrides.append(f"{dll}=")
    if headless:
        env.pop("DISPLAY", None)
        env.pop("WAYLAND_DISPLAY", None)
        overrides.append("winex11.drv,winewayland.drv=")
    elif wayland and env.get("WAYLAND_DISPLAY"):
        # Unsetting DISPLAY lets winewayland.drv take over cleanly when requested.
        env.pop("DISPLAY", None)
    env["WINEDLLOVERRIDES"] = ";".join(overrides)
    if runner == "umu":
        env["GAMEID"] = env.get("GAMEID", "umu-default")
        for p in (
            "/usr/share/steam/compatibilitytools.d/proton-cachyos",
            "/usr/share/steam/compatibilitytools.d/proton-cachyos-slr",
        ):
            if Path(p).is_dir():
                env.setdefault("PROTONPATH", p)
                break
    return env


def _check_runner(runner: str, sandbox: bool) -> None:
    if runner not in ("wine", "umu"):
        raise ValueError("Choose Wine Staging or UMU Proton in the Windows app settings.")
    if sandbox and runner == "umu":
        raise ValueError("Bubblewrap isolation is available with Wine Staging. Select Wine Staging or explicitly turn isolation off for UMU Proton.")


def _prefix_path(prefix: Path, relative: str) -> Path:
    path = prefix / relative
    if prefix.is_symlink() or not path.resolve().is_relative_to(prefix.resolve()):
        raise ValueError("A Windows environment path points outside its prefix.")
    return path


def _run_prefix_setup(
    argv: list[str], *, env: dict[str, str], prefix: Path, sandbox: bool,
    timeout: int,
) -> None:
    # Wait in the namespace that started Wine so the registry is written
    # before a fresh application sandbox opens the same prefix.
    command = ["sh", "-c", '"$@" && wineserver -w', "tsukuyomi-wine", *argv]
    if sandbox:
        command = _build_bwrap_argv(command, env=env, prefix=prefix, ro_binds=[], cwd=None)
    subprocess.run(
        command, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=timeout, check=True,
    )


def _wait_for_wine_children(argv: list[str]) -> list[str]:
    return ["sh", "-c", '"$@"; status=$?; wineserver -w; exit "$status"', "tsukuyomi-wine", *argv]


def _setup_with_status(argv: list[str]) -> list[str]:
    # Report the installer's own exit first. Keep the namespace alive for
    # delegated setup processes and any application opened by the installer.
    return [
        "sh", "-c",
        '"$@" >&2; status=$?; printf "%s\\n" "$status"; exec >/dev/null; '
        'wineserver -w; exit "$status"',
        "tsukuyomi-wine-setup", *argv,
    ]


def _run_sandbox_setup(
    argv: list[str], *, env: dict[str, str], lock_fd: int, prefix: Path,
    before_lnks: dict[Path, int], before_exes: dict[Path, int],
) -> list[dict[str, object]]:
    # Bubblewrap must outlive the wizard if setup starts the installed app.
    # The supervisor owns it and keeps the prefix locked until Wine is done.
    supervisor = (
        "trap 'exit 143' TERM\n"
        '"$@" &\n'
        "sandbox=$!\n"
        "trap 'kill \"$sandbox\" 2>/dev/null; wait \"$sandbox\"; exit 143' TERM\n"
        'wait "$sandbox"'
    )
    command = ["sh", "-c", supervisor, "tsukuyomi-wine-supervisor", *argv]
    with tempfile.TemporaryFile() as diagnostics:
        process = subprocess.Popen(
            command, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=diagnostics, start_new_session=True, pass_fds=(lock_fd,),
        )
        try:
            with process.stdout as status:
                line = status.readline(16).strip()
            code = int(line) if line.isdigit() else (process.wait() or 1)
            if code != 0:
                raise subprocess.CalledProcessError(code, argv)
            candidates = scan_shortcuts(prefix, before_lnks, before_exes)
            if not candidates:
                # A bootstrapper can exit before its real installer writes
                # the application. Preserve its existing wait and rescan.
                code = process.wait()
                if code != 0:
                    raise subprocess.CalledProcessError(code, argv)
                candidates = scan_shortcuts(prefix, before_lnks, before_exes)
            # Completion won any subsequent race with Cancel in the wizard.
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            return candidates
        except BaseException as exc:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            if isinstance(exc, subprocess.CalledProcessError):
                diagnostics.seek(max(0, diagnostics.seek(0, os.SEEK_END) - 4096))
                sys.stderr.write(diagnostics.read().decode(errors="replace"))
            raise


def _apply_prefix_hardening_and_theme(
    prefix: Path,
    *,
    sandbox: bool,
    wayland: bool,
    dxvk: bool,
    hide_standalone_tray: bool = False,
    light_setup: bool = False,
    force: bool = False,
) -> None:
    mon = detect_hypr_monitor()
    scale = max(1.0, min(3.0, float(mon.get("scale", 1.0))))
    dpi = int(round(96 * scale))
    dark = not light_setup and detect_theme_dark()

    state_sig = {
        "sandbox": sandbox,
        "wayland": wayland,
        "dxvk": dxvk,
        "dpi": dpi,
        "dark": dark,
        "framePalette": 1,
    }
    meta_file = _prefix_path(prefix, ".tsukuyomi-prefix.json")
    prev_meta = read_json(meta_file, {})
    prev_state = prev_meta.get("appliedState", {}) if isinstance(prev_meta, dict) else {}
    # This is a Wine prefix setting, including when several apps share a prefix.
    hide_standalone_tray = hide_standalone_tray or (
        isinstance(prev_state, dict) and prev_state.get("hideStandaloneTray") is True
    )
    if hide_standalone_tray:
        state_sig["hideStandaloneTray"] = True
    if not force and prev_state == state_sig:
        return

    user = os.environ.get("USER") or Path.home().name
    users_dir = _prefix_path(prefix, f"drive_c/users/{user}")
    dosdevices = _prefix_path(prefix, "dosdevices")
    dosdevices.mkdir(parents=True, exist_ok=True)
    if sandbox and users_dir.is_dir():
        for folder in ("Desktop", "Documents", "Downloads", "Music", "Pictures", "Videos"):
            target = users_dir / folder
            if target.is_symlink():
                target.unlink()
            target.mkdir(parents=True, exist_ok=True)
        z_drive = dosdevices / "z:"
        if z_drive.is_symlink() or z_drive.exists():
            z_drive.unlink(missing_ok=True)
        shared = shared_dir()
        shared.mkdir(parents=True, exist_ok=True)
        d_drive = dosdevices / "d:"
        if d_drive.is_symlink():
            d_drive.unlink()
        if not d_drive.exists():
            d_drive.symlink_to(shared)
    elif not sandbox:
        z_drive = dosdevices / "z:"
        if not z_drive.exists():
            z_drive.symlink_to("/")

    # Install DXVK/VKD3D DLLs into prefix if available
    if dxvk:
        for base_dir in (Path("/usr/share/dxvk"), Path("/usr/share/vkd3d-proton"), Path("/usr/lib/vkd3d-proton")):
            if not base_dir.is_dir():
                continue
            for arch_src, win_dst in (("x64", "system32"), ("x32", "syswow64"), ("x86", "syswow64")):
                src_dir = base_dir / arch_src
                dst_dir = _prefix_path(prefix, f"drive_c/windows/{win_dst}")
                if src_dir.is_dir() and dst_dir.is_dir():
                    for dll in src_dir.glob("*.dll"):
                        target = dst_dir / dll.name
                        if not target.exists() or target.is_symlink():
                            target.unlink(missing_ok=True)
                            target.symlink_to(dll)

    # Apply DPI, ClearType, Dark/Light theme, and Wayland/X11 driver registry
    graphics_drv = "wayland,x11" if wayland else "x11"

    if dark:
        colors = (
            '"Window"="22 22 22"\n'
            '"WindowText"="234 226 213"\n'
            '"Background"="18 14 14"\n'
            '"ButtonFace"="34 34 34"\n'
            '"ButtonText"="234 226 213"\n'
            '"ButtonHilight"="45 45 45"\n'
            '"ButtonLight"="39 39 39"\n'
            '"ButtonShadow"="31 31 31"\n'
            '"ButtonDkShadow"="25 25 25"\n'
            '"ActiveBorder"="34 34 34"\n'
            '"InactiveBorder"="34 34 34"\n'
            '"WindowFrame"="48 48 48"\n'
            '"Menu"="28 28 28"\n'
            '"MenuBar"="28 28 28"\n'
            '"MenuText"="234 226 213"\n'
            '"AppWorkSpace"="22 22 22"\n'
        )
        apps_light = "00000000"
    else:
        colors = (
            '"Window"="244 245 247"\n'
            '"WindowText"="32 33 36"\n'
            '"Background"="236 238 242"\n'
            '"ButtonFace"="232 234 238"\n'
            '"ButtonText"="32 33 36"\n'
            '"ButtonHilight"="241 242 245"\n'
            '"ButtonLight"="237 239 242"\n'
            '"ButtonShadow"="219 221 225"\n'
            '"ButtonDkShadow"="208 211 215"\n'
            '"ActiveBorder"="232 234 238"\n'
            '"InactiveBorder"="232 234 238"\n'
            '"WindowFrame"="201 204 210"\n'
            '"Menu"="244 245 247"\n'
            '"MenuBar"="244 245 247"\n'
            '"MenuText"="32 33 36"\n'
            '"AppWorkSpace"="244 245 247"\n'
        )
        apps_light = "00000001"

    reg_content = (
        "Windows Registry Editor Version 5.00\n\n"
        "[HKEY_CURRENT_USER\\Software\\Wine\\Drivers]\n"
        f'"Graphics"="{graphics_drv}"\n\n'
        "[HKEY_CURRENT_USER\\Control Panel\\Desktop]\n"
        f'"LogPixels"=dword:{dpi:08x}\n'
        '"FontSmoothing"="2"\n'
        '"FontSmoothingType"=dword:00000002\n'
        '"FontSmoothingOrientation"=dword:00000001\n\n'
        "[HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\ThemeManager]\n"
        '"ThemeActive"="0"\n\n'
        "[HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize]\n"
        f'"AppsUseLightTheme"=dword:{apps_light}\n'
        f'"SystemUsesLightTheme"=dword:{apps_light}\n\n'
        "[HKEY_CURRENT_USER\\Control Panel\\Colors]\n"
        f"{colors}\n"
    )
    if hide_standalone_tray:
        # Without an XEmbed tray host, Wine Explorer creates its own strip.
        # This disables only that fallback window, leaving host docking enabled.
        reg_content += '[HKEY_CURRENT_USER\\Software\\Wine\\Explorer]\n"ShowSystray"=dword:00000000\n\n'
    reg_dir = _prefix_path(prefix, "drive_c") if sandbox else None
    with tempfile.NamedTemporaryFile("w", suffix=".reg", dir=reg_dir, delete=False, encoding="utf-8") as tf:
        tf.write(reg_content)
        reg_file = Path(tf.name)
    try:
        env = _wine_env(prefix, wayland=wayland, dxvk=dxvk, headless=True)
        if sandbox:
            _run_prefix_setup(
                ["wine", "regedit", "/S", f"C:\\{reg_file.name}"], env=env, prefix=prefix,
                sandbox=True, timeout=45,
            )
        else:
            subprocess.run(
                ["wine", "regedit", "/S", str(reg_file)], env=env,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30, check=True,
            )
    finally:
        reg_file.unlink(missing_ok=True)

    meta = dict(prev_meta) if isinstance(prev_meta, dict) else {}
    meta.update(
        {
            "slug": prefix.name,
            "sandbox": sandbox,
            "wayland": wayland,
            "dxvk": dxvk,
            "appliedState": state_sig,
            "updatedAt": int(time.time()),
        }
    )
    atomic_write_json(meta_file, meta)


def _ensure_prefix(
    slug: str, *, sandbox: bool, wayland: bool, dxvk: bool,
    hide_standalone_tray: bool = False, light_setup: bool = False,
) -> Path:
    validate_slug(slug)
    prefix = prefixes_dir() / slug
    for relative in ("drive_c", "dosdevices", "system.reg", "user.reg"):
        _prefix_path(prefix, relative)
    is_new = not all((prefix / name).is_file() for name in ("system.reg", "user.reg"))
    prefix.mkdir(parents=True, exist_ok=True)
    if is_new:
        env = _wine_env(prefix, wayland=wayland, dxvk=dxvk, headless=True)
        _run_prefix_setup(
            ["wineboot", "--init"], env=env, prefix=prefix, sandbox=sandbox, timeout=150,
        )
        if not all((prefix / name).is_file() for name in ("system.reg", "user.reg")):
            raise ValueError("Could not prepare the Windows environment.")
    _apply_prefix_hardening_and_theme(
        prefix, sandbox=sandbox, wayland=wayland, dxvk=dxvk,
        hide_standalone_tray=hide_standalone_tray, light_setup=light_setup, force=is_new,
    )
    return prefix


def _start_menu_dirs(prefix: Path) -> list[Path]:
    user = os.environ.get("USER") or Path.home().name
    return [
        prefix / "drive_c" / "ProgramData" / "Microsoft" / "Windows" / "Start Menu",
        prefix / "drive_c" / "users" / user / "AppData" / "Roaming" / "Microsoft" / "Windows" / "Start Menu",
    ]


def _snapshot_lnk_and_exe(prefix: Path) -> tuple[dict[Path, int], dict[Path, int]]:
    drive = _prefix_path(prefix, "drive_c")
    root = drive.resolve()
    user = os.environ.get("USER") or Path.home().name
    profile = drive / "users" / user
    desktop = profile / "Desktop"
    roots = [profile / "AppData" / "Local", profile / "AppData" / "Roaming", desktop]
    if drive.is_dir():
        roots.extend(p for p in drive.iterdir() if p.name.casefold() not in ("windows", "users", "perflogs"))
    skip = {"cache", "code cache", "gpucache", "temp", "package cache", "node_modules"}
    def snapshot(bases: list[Path], suffix: str) -> dict[Path, int]:
        found = {}
        for base in bases:
            if not base.resolve().is_relative_to(root) or base.is_symlink():
                continue
            if base.is_file() and base.suffix.lower() == suffix:
                found[base] = base.stat().st_mtime_ns
                continue
            for directory, dirs, files in os.walk(base):
                dirs[:] = [name for name in dirs if name.casefold() not in skip]
                for name in files:
                    path = Path(directory) / name
                    if path.suffix.lower() != suffix or path.is_symlink():
                        continue
                    try:
                        if path.is_file():
                            found[path] = path.stat().st_mtime_ns
                    except FileNotFoundError:
                        continue
        return found
    return snapshot(_start_menu_dirs(prefix) + [desktop], ".lnk"), snapshot(roots, ".exe")


def _win_to_prefix_path(prefix: Path, win_path: str) -> Optional[Path]:
    clean = win_path.strip().strip('"')
    if len(clean) >= 3 and clean[1] == ":" and clean[2] in ("\\", "/"):
        drive = clean[0].lower()
        rel = clean[3:].replace("\\", "/").lstrip("/")
        if drive == "c":
            candidate = prefix / "drive_c" / rel
            if candidate.exists():
                return candidate
            # Case-insensitive fallback on Linux ext4/btrfs
            cur = prefix / "drive_c"
            for part in Path(rel).parts:
                if not cur.is_dir():
                    return None
                match = next((c for c in cur.iterdir() if c.name.lower() == part.lower()), None)
                if match is None:
                    return None
                cur = match
            return cur
    return None


def _is_clutter_exe(path: Path) -> bool:
    stem = path.stem.lower()
    return any(tok in stem for tok in SKIP_EXE_STEMS)


def scan_shortcuts(prefix: Path, before_lnks: dict[Path, int], before_exes: dict[Path, int]) -> list[dict[str, object]]:
    after_lnks, after_exes = _snapshot_lnk_and_exe(prefix)
    new_lnks = {p for p, stamp in after_lnks.items() if before_lnks.get(p) != stamp}
    new_exes = {p for p, stamp in after_exes.items() if before_exes.get(p) != stamp}

    candidates: list[dict[str, object]] = []
    seen_targets: set[str] = set()

    for lnk in sorted(after_lnks):
        parsed = parse_lnk(lnk)
        if not parsed or not parsed.get("target"):
            continue
        resolved = _win_to_prefix_path(prefix, parsed["target"])
        if not resolved or not resolved.is_file() or resolved.suffix.lower() != ".exe":
            continue
        if not resolved.resolve().is_relative_to((prefix / "drive_c").resolve()):
            continue
        if lnk not in new_lnks and resolved not in new_exes:
            continue
        if _is_clutter_exe(resolved) or "uninstall" in lnk.stem.lower():
            continue
        key = str(resolved).lower()
        if key in seen_targets:
            continue
        seen_targets.add(key)
        candidates.append(
            {
                "name": sanitize_desktop_value(lnk.stem, resolved.stem),
                "exe": str(resolved),
                "args": shlex.join(split_windows_args(parsed.get("arguments", ""))),
                "source": "shortcut",
            }
        )

    if not candidates:
        for exe in sorted(new_exes):
            if _is_clutter_exe(exe) or not exe.resolve().is_relative_to((prefix / "drive_c").resolve()):
                continue
            key = str(exe).lower()
            if key in seen_targets:
                continue
            seen_targets.add(key)
            pe_info = inspect_pe(exe)
            candidates.append(
                {
                    "name": sanitize_desktop_value(str(pe_info.get("product_name") or exe.stem), exe.stem),
                    "exe": str(exe),
                    "args": "",
                    "source": "executable",
                }
            )
            if len(candidates) >= 12:
                break

    return candidates


def _unique_app_id(base_name: str) -> str:
    base = slugify(base_name, "win-app")
    candidate = base
    idx = 2
    while (apps_dir() / f"{candidate}.json").exists():
        candidate = f"{base[:56]}-{idx}"
        idx += 1
    return candidate


def _existing_app_id(slug: str, exe: Path) -> str | None:
    for path in apps_dir().glob("*.json"):
        record = read_json(path, {})
        if isinstance(record, dict) and record.get("slug") == slug and record.get("exe") == str(exe):
            return validate_slug(path.stem)
    return None


def _write_desktop_entry(app_rec: dict[str, object]) -> None:
    app_id = validate_slug(str(app_rec["id"]))
    name = sanitize_desktop_value(str(app_rec["name"]), app_id)
    exe_path = Path(str(app_rec["exe"]))
    wm_class = sanitize_desktop_value(str(app_rec.get("wm_class") or exe_path.name), exe_path.name)

    icon_dst = icons_hicolor_dir() / f"tsukuyomi-win-{app_id}.png"
    icon_name = "application-x-ms-dos-executable"
    if extract_exe_icon_png(exe_path, icon_dst):
        icon_name = f"tsukuyomi-win-{app_id}"
        app_rec["icon_path"] = str(icon_dst)

    exec_cmd = format_desktop_exec(["/usr/lib/tsukuyomi/win-launch", app_id]) + " %U"
    action_prefix = format_desktop_exec(["/usr/lib/tsukuyomi/tsukuyomi-win", "open-prefix", app_id])
    action_cfg = format_desktop_exec(["/usr/lib/tsukuyomi/tsukuyomi-win", "winecfg", app_id])
    action_wayland = format_desktop_exec(["/usr/lib/tsukuyomi/tsukuyomi-win", "toggle-wayland", app_id])
    action_uninstall = format_desktop_exec(["/usr/lib/tsukuyomi/tsukuyomi-win", "uninstall", app_id])

    desktop_content = (
        "[Desktop Entry]\n"
        "Type=Application\n"
        f"Name={name}\n"
        "GenericName=Windows App\n"
        f"Comment=Run {name} via Tsukuyomi WinBridge\n"
        f"Exec={exec_cmd}\n"
        f"Icon={icon_name}\n"
        "Terminal=false\n"
        f"StartupWMClass={wm_class}\n"
        "Categories=Utility;X-Tsukuyomi-Windows;\n"
        f"Keywords=windows;exe;wine;{app_rec['slug']};\n"
        "X-Tsukuyomi-Runtime=windows\n"
        f"X-Tsukuyomi-AppId={app_id}\n"
        "Actions=OpenPrefix;WineCfg;ToggleWayland;Uninstall;\n\n"
        "[Desktop Action OpenPrefix]\n"
        "Name=Open Drive C: Folder\n"
        f"Exec={action_prefix}\n\n"
        "[Desktop Action WineCfg]\n"
        "Name=Wine Settings\n"
        f"Exec={action_cfg}\n\n"
        "[Desktop Action ToggleWayland]\n"
        "Name=Toggle Native Wayland Driver\n"
        f"Exec={action_wayland}\n\n"
        "[Desktop Action Uninstall]\n"
        "Name=Uninstall Windows App\n"
        f"Exec={action_uninstall}\n"
    )
    atomic_write_text(applications_dir() / f"tsukuyomi-win-{app_id}.desktop", desktop_content)
    atomic_write_json(apps_dir() / f"{app_id}.json", app_rec)
    refresh_desktop_caches()


def _build_bwrap_argv(
    argv: list[str],
    *,
    env: dict[str, str],
    prefix: Path,
    ro_binds: list[tuple[Path, Path]],
    cwd: Optional[Path],
    lock_fd: int | None = None,
) -> list[str]:
    if not shutil.which("bwrap"):
        raise ValueError("Windows app isolation is unavailable. Install the Tsukuyomi compatibility packages.")

    bwrap: list[str] = [
        "bwrap",
        "--die-with-parent",
        "--new-session",
        "--unshare-pid",
        "--dev", "/dev",
        "--proc", "/proc",
        "--tmpfs", "/tmp",
        "--tmpfs", "/dev/shm",
        "--clearenv",
        "--setenv", "PATH", "/usr/bin:/bin",
    ]
    if lock_fd is not None:
        bwrap.extend(["--sync-fd", str(lock_fd)])
    session_vars = {
        "USER", "LOGNAME", "HOME", "LANG", "LANGUAGE", "DISPLAY", "WAYLAND_DISPLAY",
        "XAUTHORITY", "XDG_RUNTIME_DIR", "WINEPREFIX", "WINEARCH", "WINEDEBUG",
        "WINE_NTSYNC", "WINEDLLOVERRIDES", "DRI_PRIME",
    }
    for key, value in env.items():
        if key in session_vars or key.startswith("LC_"):
            bwrap.extend(["--setenv", key, value])
    for sys_dir in ("/usr", "/sys"):
        if Path(sys_dir).exists():
            bwrap.extend(["--ro-bind", sys_dir, sys_dir])
    for filename in ("ld.so.cache", "ld.so.conf", "ld.so.conf.d", "localtime", "fonts", "ssl",
                     "ca-certificates", "pki", "hosts", "resolv.conf", "nsswitch.conf", "passwd", "group"):
        config = Path("/etc") / filename
        if config.exists():
            bwrap.extend(["--ro-bind", str(config.resolve()), str(config)])
    for link_dir in ("/bin", "/sbin", "/lib", "/lib64"):
        p = Path(link_dir)
        if p.is_symlink():
            bwrap.extend(["--symlink", os.readlink(p), link_dir])
        elif p.exists():
            bwrap.extend(["--ro-bind", link_dir, link_dir])
    if Path("/var/cache/fontconfig").is_dir():
        bwrap.extend(["--ro-bind", "/var/cache/fontconfig", "/var/cache/fontconfig"])

    for dev_path in ("/dev/dri", "/dev/ntsync", "/dev/snd"):
        if Path(dev_path).exists():
            bwrap.extend(["--dev-bind", dev_path, dev_path])
    for nv in sorted(Path("/dev").glob("nvidia*")):
        bwrap.extend(["--dev-bind", str(nv), str(nv)])

    display = re.fullmatch(r"(?:unix)?:([0-9]+)(?:\.[0-9]+)?", env.get("DISPLAY", ""))
    if display:
        x11_socket = f"/tmp/.X11-unix/X{display[1]}"
        if Path(x11_socket).is_socket():
            bwrap.extend(["--bind", x11_socket, x11_socket])
    xauth = env.get("XAUTHORITY")
    if xauth and Path(xauth).is_file():
        bwrap.extend(["--ro-bind", xauth, xauth])

    rt = xdg_runtime_dir()
    if rt.is_dir():
        bwrap.extend(["--dir", str(rt)])
        # Explicitly exclude D-Bus session bus to prevent host sandbox escapes.
        for sock_name in filter(None, [env.get("WAYLAND_DISPLAY"), "pipewire-0", "pulse"]):
            if Path(sock_name).name != sock_name or sock_name in (".", ".."):
                continue
            sock = rt / sock_name
            if sock.exists():
                bwrap.extend(["--bind", str(sock), str(sock)])

    home = Path.home()
    bwrap.extend(["--dir", str(home)])
    pfx_cache = _prefix_path(prefix, ".cache")
    pfx_cache.mkdir(parents=True, exist_ok=True)
    bwrap.extend(["--bind", str(pfx_cache), str(home / ".cache")])
    bwrap.extend(["--bind", str(prefix), str(prefix)])

    shared = shared_dir()
    shared.mkdir(parents=True, exist_ok=True)
    bwrap.extend(["--bind", str(shared), str(shared)])

    for host_src, sandbox_dst in ro_binds:
        if host_src.exists() and host_src.resolve() != home.resolve():
            bwrap.extend(["--ro-bind", str(host_src), str(sandbox_dst)])

    if cwd and cwd.is_dir():
        bwrap.extend(["--chdir", str(cwd)])

    bwrap.append("--")
    bwrap.extend(argv)
    return bwrap


def _is_safe_portable_bundle_dir(folder: Path) -> bool:
    """Only copy sibling files when exe sits in a dedicated app folder, never ~/Downloads etc."""
    resolved = folder.resolve()
    home = Path.home().resolve()
    blocked = {
        home,
        home / "Downloads",
        home / "Desktop",
        home / "Documents",
        home / "Pictures",
        home / "Videos",
        home / "Music",
        home / "Public",
        Path("/tmp").resolve(),
        Path("/var/tmp").resolve(),
    }
    if resolved in blocked or resolved.parent == resolved:
        return False
    total_bytes = 0
    file_count = 0
    for p in resolved.rglob("*"):
        if p.is_file() and not p.is_symlink():
            file_count += 1
            if file_count > 2048:
                return False
            try:
                total_bytes += p.stat().st_size
            except OSError:
                pass
            if total_bytes > 512 * 1024 * 1024:
                return False
    return True


def _installer_binds(src: Path, mount_root: Path, share_folder: bool) -> list[tuple[Path, Path]]:
    if share_folder:
        if not _is_safe_portable_bundle_dir(src.parent):
            raise ValueError("Put the installer and its companion files in a dedicated folder before sharing it.")
        return [(src.parent, mount_root)]
    return [(src, mount_root / src.name)]


def _decode_uri_path(raw: str) -> str:
    if raw.startswith("file://"):
        parsed = urlparse(raw)
        if parsed.scheme == "file":
            return unquote(parsed.path)
    return raw


class InstallCancelled(Exception):
    pass


class PrefixBusy(ValueError):
    pass


def _interrupt_install(_signum: int, _frame: object) -> None:
    raise InstallCancelled


@contextmanager
def _installation_prefix(slug: str, *, fresh: bool):
    parent = prefixes_dir()
    parent.mkdir(parents=True, exist_ok=True)
    prefix = parent / slug
    if fresh:
        index = 2
        while True:
            try:
                prefix.mkdir(mode=0o700)
                break
            except FileExistsError:
                prefix = parent / f"{slug[:56]}-{index}"
                index += 1
    lock_dir = xdg_runtime_dir()
    lock_dir.mkdir(parents=True, exist_ok=True)
    with (lock_dir / f"tsukuyomi-win-{prefix.name}.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise PrefixBusy("Another Windows app or setup is using this environment. Close it and try again.") from exc
        try:
            yield prefix, lock.fileno()
        except (Exception, KeyboardInterrupt):
            if fresh:
                if (prefix / "system.reg").is_file():
                    run_cmd(["wineserver", "-k"], env=_wine_env(prefix), timeout=5)
                shutil.rmtree(prefix, ignore_errors=True)
            raise


def cmd_install(args: argparse.Namespace) -> int:
    previous_handler = signal.signal(signal.SIGTERM, _interrupt_install)
    try:
        return _install(args)
    except InstallCancelled:
        print(json.dumps({"ok": False, "cancelled": True, "error": "Windows setup was cancelled."}))
    except subprocess.TimeoutExpired:
        print(json.dumps({"ok": False, "error": "The Windows environment took too long to respond. Close any app using it and try again."}))
    except subprocess.CalledProcessError as exc:
        print(json.dumps({"ok": False, "error": f"Windows setup stopped (exit code {exc.returncode}). If a Windows setup window is still open, close it before trying again."}))
    except (OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
    finally:
        signal.signal(signal.SIGTERM, previous_handler)
    return 1


def _install(args: argparse.Namespace) -> int:
    src = Path(_decode_uri_path(args.file)).expanduser().resolve()
    if not src.is_file():
        raise ValueError(f"File not found: {src}")

    # If user opened a Windows .lnk shortcut directly, resolve local target when possible
    lnk_extra_args: list[str] = []
    if src.suffix.lower() == ".lnk":
        parsed = parse_lnk(src)
        if not parsed:
            raise ValueError("This file is not a readable Windows shortcut.")
        for target in (parsed["relative_path"], parsed["target"]):
            relative = PureWindowsPath(target)
            if relative.anchor:
                continue
            candidate = src.parent.joinpath(*relative.parts).resolve()
            if candidate.is_relative_to(src.parent) and candidate.is_file():
                src = candidate
                lnk_extra_args = split_windows_args(parsed["arguments"])
                break
        else:
            raise ValueError("This shortcut has no local target. Open its original Windows EXE or MSI.")
    if src.suffix.lower() not in (".exe", ".msi"):
        raise ValueError("Choose a Windows .exe or .msi, or a .lnk with a local target.")

    cfg = load_config()
    mode = args.mode
    sandbox = args.sandbox if args.sandbox is not None else bool(cfg["defaultSandbox"])
    wayland = args.wayland if args.wayland is not None else bool(cfg["defaultWayland"])
    dxvk = args.dxvk if args.dxvk is not None else bool(cfg["defaultDxvk"])
    runner = args.runner or str(cfg["defaultRunner"])
    _check_runner(runner, sandbox)
    if src.suffix.lower() == ".msi":
        if mode == "portable":
            raise ValueError("An MSI package uses Windows Installer. Choose Install Windows App.")
        if runner == "umu":
            raise ValueError("Choose Wine Staging to install an MSI package.")
    if not shutil.which("wine"):
        raise ValueError("The Windows runtime is missing. Install or update Tsukuyomi's compatibility packages.")
    if runner == "umu" and not shutil.which("umu-run"):
        raise ValueError("The Proton runner is missing. Choose the bundled Windows runtime in Options.")

    pe_info = inspect_pe(src)
    if error := pe_info.get("error"):
        raise ValueError(str(error))
    if pe_info["arch"] == "arm64":
        raise ValueError("This Windows executable is for ARM64. Choose the x64 or x86 download.")
    app_name = sanitize_desktop_value(args.name or str(pe_info.get("product_name") or src.stem), src.stem)

    if mode == "existing":
        slug = validate_slug(args.slug)
        if not (prefixes_dir() / slug).is_dir():
            raise ValueError("This app environment no longer exists. Choose a new installation.")
    elif mode == "portable" and not args.pin_portable:
        slug = "portable-sandbox"
    else:
        slug = slugify(args.slug or app_name, "win-app")

    fresh = mode == "isolated" or (mode == "portable" and args.pin_portable)
    with _installation_prefix(slug, fresh=fresh) as (prefix, lock_fd):
        return _install_in_prefix(
            args, src, lnk_extra_args, app_name, prefix.name, lock_fd=lock_fd,
            sandbox=sandbox, wayland=wayland, dxvk=dxvk, runner=runner,
            antigravity_setup=pe_info["product_name"] == "Antigravity" and pe_info["company"] == "Google",
        )


def _install_in_prefix(
    args: argparse.Namespace, src: Path, lnk_extra_args: list[str], app_name: str, slug: str, *,
    lock_fd: int, sandbox: bool, wayland: bool, dxvk: bool, runner: str, antigravity_setup: bool,
) -> int:
    mode = args.mode
    msi = src.suffix.lower() == ".msi"
    # MSI dialogs can paint embedded black text. Use the standard light
    # controls during setup, then apply the desktop preference at app launch.
    prefix = _ensure_prefix(
        slug, sandbox=sandbox, wayland=wayland, dxvk=dxvk, hide_standalone_tray=antigravity_setup,
        light_setup=msi,
    )
    env = _wine_env(prefix, wayland=wayland, dxvk=dxvk, runner=runner)

    if mode == "portable" and not args.pin_portable:
        base_bin = ["umu-run"] if runner == "umu" else ["wine"]
        if sandbox:
            mount_root = Path("/mnt/tsukuyomi-src")
            ro_binds = _installer_binds(src, mount_root, args.share_installer_folder)
            run_target = f"E:\\{src.name}"
            e_drive = prefix / "dosdevices" / "e:"
            e_drive.unlink(missing_ok=True)
            e_drive.symlink_to(mount_root)
            try:
                argv = _build_bwrap_argv(
                    _wait_for_wine_children(base_bin + [run_target] + lnk_extra_args),
                    env=env, prefix=prefix, ro_binds=ro_binds, cwd=None,
                )
                subprocess.run(argv, env=env, stdout=sys.stderr, check=True)
            finally:
                e_drive.unlink(missing_ok=True)
        else:
            subprocess.run(base_bin + [str(src)] + lnk_extra_args, env=env, cwd=src.parent, stdout=sys.stderr, check=True)
        print(json.dumps({"ok": True, "mode": "portable", "candidates": []}))
        return 0

    before_lnks, before_exes = _snapshot_lnk_and_exe(prefix)

    if mode == "portable" and args.pin_portable:
        dest_dir = prefix / "drive_c" / "Program Files" / slug
        dest_dir.mkdir(parents=True, exist_ok=True)
        if _is_safe_portable_bundle_dir(src.parent):
            shutil.copytree(src.parent, dest_dir, dirs_exist_ok=True, symlinks=True)
        else:
            shutil.copy2(src, dest_dir / src.name)
        installed_exe = dest_dir / src.name
        app_id = _unique_app_id(app_name)
        rec = {
            "id": app_id,
            "slug": slug,
            "name": app_name,
            "exe": str(installed_exe),
            "args": " ".join(shlex.quote(a) for a in lnk_extra_args),
            "runner": runner,
            "wayland": wayland,
            "sandbox": sandbox,
            "dxvk": dxvk,
            "wm_class": installed_exe.name,
            "created_at": int(time.time()),
        }
        _write_desktop_entry(rec)
        print(json.dumps({"ok": True, "slug": slug, "exported": [rec]}))
        return 0

    e_drive = prefix / "dosdevices" / "e:"
    if runner == "wine" and antigravity_setup:
        # Google's NSIS build treats the Wine PowerShell stub's exit 0 as
        # proof that Get-CimInstance found a process. Use its tasklist path.
        env["WINEDLLOVERRIDES"] += ";powershell.exe="
    base_bin = ["umu-run"] if runner == "umu" else ["wine"]
    if msi:
        base_bin += ["msiexec", "/i"]
    if sandbox:
        mount_root = Path("/mnt/tsukuyomi-src")
        ro_binds = _installer_binds(src, mount_root, args.share_installer_folder)
        target_arg = f"E:\\{src.name}"
        argv = _build_bwrap_argv(
            _setup_with_status(base_bin + [target_arg] + lnk_extra_args),
            env=env, prefix=prefix, ro_binds=ro_binds, cwd=None, lock_fd=lock_fd,
        )
        e_drive.unlink(missing_ok=True)
        e_drive.symlink_to(mount_root)
        try:
            candidates = _run_sandbox_setup(
                argv, env=env, lock_fd=lock_fd, prefix=prefix,
                before_lnks=before_lnks, before_exes=before_exes,
            )
        finally:
            e_drive.unlink(missing_ok=True)
    else:
        argv = base_bin + [str(src)] + lnk_extra_args
        subprocess.run(argv, env=env, cwd=src.parent, stdout=sys.stderr, check=True)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        candidates = scan_shortcuts(prefix, before_lnks, before_exes)
    for candidate in candidates:
        candidate.update(runner=runner, wayland=wayland, sandbox=sandbox, dxvk=dxvk)
    print(
        json.dumps(
            {
                "ok": True,
                "exitCode": 0,
                "slug": slug,
                "prefix": str(prefix),
                "runner": runner,
                "wayland": wayland,
                "sandbox": sandbox,
                "dxvk": dxvk,
                "candidates": candidates,
            }
        )
    )
    return 0


def cmd_export_desktop(args: argparse.Namespace) -> int:
    slug = validate_slug(args.slug)
    prefix = prefixes_dir() / slug
    if not prefix.is_dir():
        print(json.dumps({"ok": False, "error": f"Unknown prefix: {slug}"}))
        return 1
    meta = read_json(prefix / ".tsukuyomi-prefix.json", {})
    if not isinstance(meta, dict):
        meta = {}
    selected = json.loads(args.select)
    exported = []
    for item in selected:
        exe = Path(str(item["exe"]))
        if not exe.is_file() or not exe.resolve().is_relative_to((prefix / "drive_c").resolve()):
            continue
        name = sanitize_desktop_value(str(item.get("name") or exe.stem), exe.stem)
        app_id = _existing_app_id(slug, exe) or _unique_app_id(name)
        rec = {
            "id": app_id,
            "slug": slug,
            "name": name,
            "exe": str(exe),
            "args": sanitize_desktop_value(str(item.get("args") or "")),
            "runner": str(item.get("runner") or meta.get("runner") or "wine"),
            "wayland": bool(item.get("wayland", meta.get("wayland", False))),
            "sandbox": bool(item.get("sandbox", meta.get("sandbox", True))),
            "dxvk": bool(item.get("dxvk", meta.get("dxvk", True))),
            "wm_class": exe.name,
            "created_at": int(time.time()),
        }
        _write_desktop_entry(rec)
        exported.append(rec)
    if not exported:
        print(json.dumps({"ok": False, "error": "No installed application could be added to App Launcher."}))
        return 1
    print(json.dumps({"ok": True, "exported": exported}))
    return 0


def _convert_arg_for_wine(prefix: Path, arg: str, env: dict[str, str]) -> str:
    p = Path(arg)
    if arg.startswith(("http://", "https://")) or not (arg.startswith("/") or p.exists()):
        return arg
    res = run_cmd(["winepath", "-w", str(p.resolve())], env=env, timeout=5)
    if res.returncode == 0 and res.stdout.strip():
        return res.stdout.strip()
    return arg


def _focus_running_app(prefix: Path, exe: Path) -> bool:
    result = run_cmd(["hyprctl", "clients", "-j"], timeout=3)
    if result.returncode != 0:
        return False
    try:
        windows = json.loads(result.stdout)
    except ValueError:
        return False
    if not isinstance(windows, list):
        return False
    expected_prefix = os.fsencode(f"WINEPREFIX={prefix}")
    for window in windows:
        if str(window.get("initialClass", "")).casefold() != exe.name.casefold():
            continue
        pid = window.get("pid")
        address = str(window.get("address", ""))
        if not isinstance(pid, int) or pid <= 0 or not re.fullmatch(r"0x[\da-fA-F]+", address):
            continue
        try:
            with Path(f"/proc/{pid}/environ").open("rb") as process_env:
                if expected_prefix not in process_env.read(131072).split(b"\0"):
                    continue
        except OSError:
            continue
        focused = run_cmd(["hyprctl", "dispatch", f'hl.dsp.focus({{window = "address:{address}"}})'], timeout=3)
        return focused.returncode == 0
    return False


def cmd_run(args: argparse.Namespace) -> int:
    app_id = validate_slug(args.app_id)
    rec = read_json(apps_dir() / f"{app_id}.json")
    if not isinstance(rec, dict):
        print(f"tsukuyomi-win: app not found: {app_id}", file=sys.stderr)
        return 1

    slug = validate_slug(str(rec["slug"]))
    prefix = prefixes_dir() / slug
    exe = Path(str(rec["exe"]))
    if not exe.is_file():
        print(f"tsukuyomi-win: executable missing: {exe}", file=sys.stderr)
        return 1

    try:
        with _installation_prefix(slug, fresh=False):
            return _launch_registered_app(args, rec, prefix, exe)
    except PrefixBusy:
        if not args.extra_args and _focus_running_app(prefix, exe):
            return 0
        raise


def _launch_registered_app(args: argparse.Namespace, rec: dict, prefix: Path, exe: Path) -> int:
    wayland = bool(rec.get("wayland", False))
    dxvk = bool(rec.get("dxvk", True))
    sandbox = bool(rec.get("sandbox", True))
    runner = str(rec.get("runner") or "wine")
    antigravity = exe.name.casefold() == "antigravity.exe"
    _check_runner(runner, sandbox)
    if exe.suffix.lower() != ".exe" or not exe.resolve().is_relative_to(_prefix_path(prefix, "drive_c").resolve()):
        raise ValueError("The Windows executable must be inside its app environment.")

    _ensure_prefix(
        prefix.name, sandbox=sandbox, wayland=wayland, dxvk=dxvk,
        hide_standalone_tray=antigravity,
    )
    env = _wine_env(prefix, wayland=wayland, dxvk=dxvk, runner=runner)

    extra_args = shlex.split(str(rec.get("args") or ""))
    # Electron's accelerated compositor can repaint only part of the window
    # and leave its controls unresponsive on software-rendered XWayland.
    if (antigravity and runner == "wine" and not wayland
            and env.get("TSUKUYOMI_SOFTWARE_RENDERER") == "1"
            and "--disable-gpu" not in extra_args and "--disable-gpu" not in args.extra_args):
        extra_args.append("--disable-gpu")
    converted_user_args: list[str] = []
    ro_binds: list[tuple[Path, Path]] = []
    open_root = Path("/mnt/tsukuyomi-open")
    mapped_open = False
    for idx, raw in enumerate(args.extra_args):
        decoded = _decode_uri_path(raw)
        p = Path(decoded)
        if p.exists() and sandbox:
            rp = p.resolve()
            dst = open_root / f"f{idx}" / rp.name
            ro_binds.append((rp, dst))
            converted_user_args.append(f"E:\\f{idx}\\{rp.name}")
            mapped_open = True
        elif sandbox:
            converted_user_args.append(decoded)
        else:
            converted_user_args.append(_convert_arg_for_wine(prefix, decoded, env))

    if runner == "umu" and not shutil.which("umu-run"):
        raise ValueError("The Proton runner is missing. Change the app's compatibility settings.")
    base_bin = ["umu-run"] if runner == "umu" else ["wine"]
    argv = base_bin + [str(exe)] + extra_args + converted_user_args

    if sandbox:
        e_drive = prefix / "dosdevices" / "e:"
        if mapped_open:
            e_drive.unlink(missing_ok=True)
            e_drive.symlink_to(open_root)
        try:
            bwrap_argv = _build_bwrap_argv(
                _wait_for_wine_children(argv), env=env, prefix=prefix, ro_binds=ro_binds, cwd=exe.parent,
            )
            return subprocess.run(bwrap_argv, env=env, shell=False).returncode
        finally:
            if mapped_open:
                e_drive.unlink(missing_ok=True)
    return subprocess.run(argv, env=env, cwd=str(exe.parent), shell=False).returncode


def cmd_list(_args: argparse.Namespace) -> int:
    apps = []
    if apps_dir().is_dir():
        for f in sorted(apps_dir().glob("*.json")):
            data = read_json(f)
            if isinstance(data, dict):
                apps.append(data)
    prefixes = []
    if prefixes_dir().is_dir():
        for d in sorted(prefixes_dir().iterdir()):
            if d.is_dir():
                meta = read_json(d / ".tsukuyomi-prefix.json", {})
                prefixes.append({"slug": d.name, "path": str(d), "meta": meta if isinstance(meta, dict) else {}})
    print(json.dumps({"apps": apps, "prefixes": prefixes, "config": load_config()}))
    return 0


def cmd_configure(args: argparse.Namespace) -> int:
    app_id = validate_slug(args.app_id)
    rec = read_json(apps_dir() / f"{app_id}.json")
    if not isinstance(rec, dict):
        print(json.dumps({"ok": False, "error": f"App not found: {app_id}"}))
        return 1
    if args.runner in ("wine", "umu"):
        rec["runner"] = args.runner
    if args.wayland is not None:
        rec["wayland"] = args.wayland
    if args.sandbox is not None:
        rec["sandbox"] = args.sandbox
    if args.dxvk is not None:
        rec["dxvk"] = args.dxvk
    try:
        _check_runner(str(rec.get("runner") or "wine"), bool(rec.get("sandbox", True)))
    except ValueError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 1
    _write_desktop_entry(rec)
    print(json.dumps({"ok": True, "app": rec}))
    return 0


def cmd_toggle_wayland(args: argparse.Namespace) -> int:
    app_id = validate_slug(args.app_id)
    rec = read_json(apps_dir() / f"{app_id}.json")
    if not isinstance(rec, dict):
        return 1
    rec["wayland"] = not bool(rec.get("wayland", False))
    _write_desktop_entry(rec)
    mode_txt = "Native Wayland" if rec["wayland"] else "XWayland"
    if shutil.which("notify-send"):
        run_cmd(["notify-send", "Tsukuyomi WinBridge", f"{rec['name']}: switched to {mode_txt}"])
    return 0


def cmd_open_prefix(args: argparse.Namespace) -> int:
    app_id = validate_slug(args.app_id)
    rec = read_json(apps_dir() / f"{app_id}.json")
    if not isinstance(rec, dict):
        return 1
    drive_c = prefixes_dir() / validate_slug(str(rec["slug"])) / "drive_c"
    if drive_c.is_dir() and shutil.which("xdg-open"):
        subprocess.Popen(["xdg-open", str(drive_c)], shell=False)
    return 0


def cmd_tool(args: argparse.Namespace, tool: str) -> int:
    app_id = validate_slug(args.app_id)
    rec = read_json(apps_dir() / f"{app_id}.json")
    if not isinstance(rec, dict):
        return 1
    slug = validate_slug(str(rec["slug"]))
    command = ["winecfg"] if tool == "winecfg" else ["winetricks", "--gui"]
    if not shutil.which(command[0]):
        return 1
    try:
        with _installation_prefix(slug, fresh=False) as (prefix, _):
            env = _wine_env(prefix, wayland=bool(rec.get("wayland", False)), dxvk=bool(rec.get("dxvk", True)))
            if rec.get("sandbox", True):
                command = _build_bwrap_argv(
                    _wait_for_wine_children(command), env=env, prefix=prefix, ro_binds=[], cwd=None,
                )
            return subprocess.run(command, env=env, shell=False).returncode
    except (OSError, ValueError) as exc:
        print(f"tsukuyomi-win: {exc}", file=sys.stderr)
        return 1


def cmd_uninstall(args: argparse.Namespace) -> int:
    app_id = validate_slug(args.app_id)
    rec_path = apps_dir() / f"{app_id}.json"
    rec = read_json(rec_path)
    if not isinstance(rec, dict):
        print(json.dumps({"ok": False, "error": f"App not found: {app_id}"}))
        return 1
    slug = validate_slug(str(rec["slug"]))
    try:
        with _installation_prefix(slug, fresh=False) as (prefix, _):
            _remove_registered_app(app_id, rec_path, prefix)
    except (OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 1
    return 0


def _remove_registered_app(app_id: str, rec_path: Path, prefix: Path) -> None:
    # Keep a shared prefix until its last launcher has been removed.
    keep_prefix = any(
        isinstance(data := read_json(other), dict) and data.get("slug") == prefix.name
        for other in apps_dir().glob("*.json")
        if other != rec_path
    )
    if not keep_prefix and prefix.is_dir():
        shutil.rmtree(prefix)

    (applications_dir() / f"tsukuyomi-win-{app_id}.desktop").unlink(missing_ok=True)
    (icons_hicolor_dir() / f"tsukuyomi-win-{app_id}.png").unlink(missing_ok=True)
    rec_path.unlink(missing_ok=True)
    refresh_desktop_caches()
    print(json.dumps({"ok": True, "removed": app_id, "prefixRemoved": not keep_prefix}))


def parse_bool_str(v: str) -> bool:
    low = v.strip().lower()
    if low in ("1", "true", "yes", "on"):
        return True
    if low in ("0", "false", "no", "off"):
        return False
    raise argparse.ArgumentTypeError(f"Expected boolean, got {v!r}")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="tsukuyomi-win")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status")
    sub.add_parser("list")

    p_ins = sub.add_parser("inspect")
    p_ins.add_argument("file")

    p_inst = sub.add_parser("install")
    p_inst.add_argument("--file", required=True)
    p_inst.add_argument("--name", default="")
    p_inst.add_argument("--mode", choices=("isolated", "portable", "existing"), default="isolated")
    p_inst.add_argument("--slug", default="")
    p_inst.add_argument("--runner", choices=("wine", "umu"), default="")
    p_inst.add_argument("--wayland", type=parse_bool_str, default=None)
    p_inst.add_argument("--sandbox", type=parse_bool_str, default=None)
    p_inst.add_argument("--dxvk", type=parse_bool_str, default=None)
    p_inst.add_argument("--pin-portable", action="store_true")
    p_inst.add_argument("--share-installer-folder", action="store_true")

    p_exp = sub.add_parser("export-desktop")
    p_exp.add_argument("slug")
    p_exp.add_argument("--select", required=True)

    p_run = sub.add_parser("run")
    p_run.add_argument("app_id")
    p_run.add_argument("extra_args", nargs=argparse.REMAINDER)

    p_cfg = sub.add_parser("configure")
    p_cfg.add_argument("app_id")
    p_cfg.add_argument("--runner", choices=("wine", "umu"), default="")
    p_cfg.add_argument("--wayland", type=parse_bool_str, default=None)
    p_cfg.add_argument("--sandbox", type=parse_bool_str, default=None)
    p_cfg.add_argument("--dxvk", type=parse_bool_str, default=None)

    p_def = sub.add_parser("set-defaults")
    p_def.add_argument("--runner", choices=("wine", "umu"), default="")
    p_def.add_argument("--wayland", type=parse_bool_str, default=None)
    p_def.add_argument("--sandbox", type=parse_bool_str, default=None)
    p_def.add_argument("--dxvk", type=parse_bool_str, default=None)

    for simple in ("toggle-wayland", "open-prefix", "winecfg", "winetricks", "uninstall"):
        sp = sub.add_parser(simple)
        sp.add_argument("app_id")

    args = parser.parse_args(argv)
    if args.cmd == "status":
        print(json.dumps(check_status()))
        return 0
    if args.cmd == "inspect":
        src = Path(_decode_uri_path(args.file)).expanduser().resolve()
        if not src.is_file() or src.suffix.lower() not in (".exe", ".msi", ".lnk"):
            print(json.dumps({"error": "Choose a Windows .exe, .msi or .lnk file."}))
            return 1
        info = inspect_pe(src)
        if info.get("error"):
            print(json.dumps(info))
            return 1
        icon_tmp = xdg_runtime_dir() / "tsukuyomi-win-preview.png"
        icon_tmp.unlink(missing_ok=True)
        if extract_exe_icon_png(src, icon_tmp):
            info["icon_preview"] = str(icon_tmp)
        else:
            info["icon_preview"] = ""
        print(json.dumps(info))
        return 0
    if args.cmd == "install":
        return cmd_install(args)
    if args.cmd == "export-desktop":
        return cmd_export_desktop(args)
    if args.cmd == "run":
        try:
            result = cmd_run(args)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            print(f"tsukuyomi-win: {exc}", file=sys.stderr)
            result = 1
        if result != 0 and shutil.which("notify-send"):
            run_cmd(["notify-send", "Windows app could not open", "Check the app's settings in Tsukuyomi Hub → Compatibility."], timeout=3)
        return result
    if args.cmd == "list":
        return cmd_list(args)
    if args.cmd == "configure":
        return cmd_configure(args)
    if args.cmd == "set-defaults":
        cfg = load_config()
        if args.runner:
            cfg["defaultRunner"] = args.runner
        if args.wayland is not None:
            cfg["defaultWayland"] = args.wayland
        if args.sandbox is not None:
            cfg["defaultSandbox"] = args.sandbox
        if args.dxvk is not None:
            cfg["defaultDxvk"] = args.dxvk
        try:
            _check_runner(str(cfg["defaultRunner"]), bool(cfg["defaultSandbox"]))
        except ValueError as exc:
            print(json.dumps({"ok": False, "error": str(exc)}))
            return 1
        save_config(cfg)
        print(json.dumps({"ok": True, "config": cfg}))
        return 0
    if args.cmd == "toggle-wayland":
        return cmd_toggle_wayland(args)
    if args.cmd == "open-prefix":
        return cmd_open_prefix(args)
    if args.cmd in ("winecfg", "winetricks"):
        return cmd_tool(args, args.cmd)
    if args.cmd == "uninstall":
        return cmd_uninstall(args)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
