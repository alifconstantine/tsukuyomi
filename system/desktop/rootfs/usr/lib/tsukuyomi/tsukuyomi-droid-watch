#!/usr/bin/env python3
"""Lightweight user session watcher that keeps Waydroid .desktop entries and icons synced."""

from __future__ import annotations

import json
import shutil
import signal
import subprocess
import time
from pathlib import Path

from compat_common import xdg_data_home

RUNNING = True
WAYDROID_CFG = Path("/var/lib/waydroid/waydroid.cfg")
IDLE_SLEEP_SEC = 600.0  # Auto-sleep Android container after 10 minutes with zero open Waydroid windows


def _stop(_sig: int, _frame: object) -> None:
    global RUNNING
    RUNNING = False


def _has_open_waydroid_window() -> bool:
    if not shutil.which("hyprctl"):
        return True
    try:
        res = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3)
        if res.returncode != 0:
            return True
        clients = json.loads(res.stdout)
        if not isinstance(clients, list):
            return True
        for c in clients:
            cls = str(c.get("class") or "").lower()
            if cls == "waydroid" or cls.startswith("waydroid.") or cls == "gamescope":
                return True
        return False
    except (OSError, ValueError, subprocess.SubprocessError):
        return True


def _waydroid_session_active() -> bool:
    if not shutil.which("waydroid"):
        return False
    try:
        res = subprocess.run(["waydroid", "status"], capture_output=True, text=True, timeout=3)
        return "Session:\tRUNNING" in res.stdout or "Session: RUNNING" in res.stdout
    except (OSError, subprocess.SubprocessError):
        return False


def _needs_sync() -> dict[str, int]:
    apps_dir = xdg_data_home() / "applications"
    icons_dir = xdg_data_home() / "waydroid" / "data" / "icons"
    hicolor_dir = xdg_data_home() / "icons" / "hicolor" / "256x256" / "apps"
    pending: dict[str, int] = {}

    if apps_dir.is_dir():
        for p in apps_dir.glob("waydroid.*.desktop"):
            try:
                text = p.read_text(encoding="utf-8", errors="ignore")
                if "X-Tsukuyomi-Runtime=android" not in text:
                    pending[str(p)] = p.stat().st_mtime_ns
            except OSError:
                pass

    if icons_dir.is_dir():
        for icon in icons_dir.glob("*.png"):
            try:
                pkg = icon.stem
                if not (apps_dir / f"waydroid.{pkg}.desktop").is_file():
                    continue
                target = hicolor_dir / f"waydroid.{pkg}.png"
                src_mtime = icon.stat().st_mtime_ns
                if not target.is_file() or target.stat().st_mtime_ns < src_mtime:
                    pending[str(icon)] = src_mtime
            except OSError:
                pass

    return pending


def main() -> int:
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    last_pending: dict[str, int] = {}
    idle_since: float | None = None
    last_idle_check = 0.0
    while RUNNING:
        # Sleep gently with zero disk scanning when Waydroid has never been initialized.
        if not WAYDROID_CFG.is_file():
            time.sleep(15.0)
            continue

        pending = _needs_sync()
        if pending and pending != last_pending:
            time.sleep(0.8)
            subprocess.run(["/usr/lib/tsukuyomi/tsukuyomi-droid", "sync-desktop"], shell=False, capture_output=True)
            last_pending = _needs_sync()
        elif not pending:
            last_pending = {}

        now = time.monotonic()
        if now - last_idle_check >= 30.0:
            last_idle_check = now
            if _waydroid_session_active():
                if _has_open_waydroid_window():
                    idle_since = None
                elif idle_since is None:
                    idle_since = now
                elif now - idle_since >= IDLE_SLEEP_SEC:
                    subprocess.run(["/usr/lib/tsukuyomi/tsukuyomi-droid", "sleep"], shell=False, capture_output=True)
                    idle_since = None
            else:
                idle_since = None

        time.sleep(3.0)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
