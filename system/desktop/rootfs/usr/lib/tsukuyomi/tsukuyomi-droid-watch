#!/usr/bin/env python3
"""Lightweight user session watcher that keeps Waydroid .desktop entries synced."""

from __future__ import annotations

import os
import signal
import subprocess
import time
from pathlib import Path

from compat_common import xdg_data_home

RUNNING = True


def _stop(_sig: int, _frame: object) -> None:
    global RUNNING
    RUNNING = False


def _snapshot() -> dict[str, int]:
    apps_dir = xdg_data_home() / "applications"
    icons_dir = xdg_data_home() / "waydroid" / "data" / "icons"
    snap: dict[str, int] = {}
    for folder, pat in ((apps_dir, "waydroid.*.desktop"), (icons_dir, "*.png")):
        if folder.is_dir():
            for p in folder.glob(pat):
                try:
                    snap[str(p)] = p.stat().st_mtime_ns
                except OSError:
                    pass
    return snap


def main() -> int:
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    last_raw: dict[str, int] = {}
    while RUNNING:
        apps_dir = xdg_data_home() / "applications"
        raw_apps: dict[str, int] = {}
        if apps_dir.is_dir():
            for p in apps_dir.glob("waydroid.*.desktop"):
                try:
                    text = p.read_text(encoding="utf-8", errors="ignore")
                    if "X-Tsukuyomi-Runtime=android" not in text:
                        raw_apps[str(p)] = p.stat().st_mtime_ns
                except OSError:
                    pass

        if raw_apps and raw_apps != last_raw:
            time.sleep(0.8)
            subprocess.run(["/usr/lib/tsukuyomi/tsukuyomi-droid", "sync-desktop"], shell=False, capture_output=True)
            last_raw = _snapshot()

        time.sleep(2.0)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
