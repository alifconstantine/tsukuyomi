#!/usr/bin/env python3
"""Privileged helper for Tsukuyomi DroidBridge (invoked via pkexec)."""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Optional

USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
DRM_NODE_RE = re.compile(r"^/dev/dri/renderD[0-9]+$")
WAYDROID_CFG = Path("/var/lib/waydroid/waydroid.cfg")
FSTAB_PATH = Path("/etc/fstab")


def run_cmd(argv: list[str], *, check: bool = False, stream: bool = False) -> subprocess.CompletedProcess[str]:
    if stream:
        res = subprocess.run(argv, shell=False, text=True, check=check)
        return subprocess.CompletedProcess(argv, res.returncode, "", "")
    return subprocess.run(argv, shell=False, text=True, capture_output=True, check=check)


def _find_offline_images() -> Optional[Path]:
    for d in (Path("/etc/waydroid-extra/images"), Path("/usr/share/waydroid-extra/images")):
        if (d / "system.img").is_file() and (d / "vendor.img").is_file():
            return d
    return None


def _update_cfg_section(section: str, updates: dict[str, str]) -> None:
    if not WAYDROID_CFG.is_file() or not updates:
        return
    lines = WAYDROID_CFG.read_text(encoding="utf-8").splitlines()
    out: list[str] = []
    target_hdr = f"[{section.lower()}]"
    in_sec = False
    applied: set[str] = set()

    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if in_sec:
                for k, v in updates.items():
                    if k not in applied:
                        out.append(f"{k} = {v}")
                        applied.add(k)
            in_sec = stripped.lower() == target_hdr
            out.append(line)
            continue

        if in_sec and "=" in line and not stripped.startswith("#"):
            key = line.split("=", 1)[0].strip()
            if key in updates:
                out.append(f"{key} = {updates[key]}")
                applied.add(key)
                continue
        out.append(line)

    if in_sec:
        for k, v in updates.items():
            if k not in applied:
                out.append(f"{k} = {v}")
                applied.add(k)
    elif len(applied) < len(updates):
        out.append("")
        out.append(f"[{section}]")
        for k, v in updates.items():
            if k not in applied:
                out.append(f"{k} = {v}")

    WAYDROID_CFG.write_text("\n".join(out) + "\n", encoding="utf-8")


def cmd_init(args: argparse.Namespace) -> int:
    img_dir = _find_offline_images()
    if args.offline and not img_dir:
        print("Offline Waydroid images not found in /usr/share/waydroid-extra/images or /etc/waydroid-extra/images", file=sys.stderr)
        return 1

    if not WAYDROID_CFG.is_file() or args.force:
        if img_dir and not args.gapps:
            res = run_cmd(["waydroid", "init", "-f", "-i", str(img_dir)])
        elif args.gapps:
            res = run_cmd(["waydroid", "init", "-s", "GAPPS", "-f"])
        else:
            res = run_cmd(["waydroid", "init", "-f"])
        if res.returncode != 0:
            sys.stderr.write(res.stderr or res.stdout)
            return res.returncode

    props = {
        "persist.waydroid.multi_windows": "true",
        "persist.waydroid.cursor_on_subsurface": "true",
    }
    if args.gpu == "swiftshader":
        props["ro.hardware.gralloc"] = "default"
        props["ro.hardware.egl"] = "swiftshader"
    else:
        props["ro.hardware.gralloc"] = "gbm"
        props["ro.hardware.egl"] = "mesa"
    if args.viewport:
        width, height = args.viewport
        props["persist.waydroid.multi_windows"] = "false"
        props["persist.waydroid.width"] = str(width)
        props["persist.waydroid.height"] = str(height)

    _update_cfg_section("properties", props)
    if args.drm_node and DRM_NODE_RE.match(args.drm_node) and Path(args.drm_node).exists():
        _update_cfg_section("waydroid", {"drm_device": args.drm_node})

    for command in (
        ["waydroid", "upgrade", "--offline"],
        ["systemctl", "enable", "waydroid-container.service"],
        ["systemctl", "restart", "waydroid-container.service"],
    ):
        result = run_cmd(command)
        if result.returncode != 0:
            sys.stderr.write(result.stderr or result.stdout or "Android setup could not finish.\n")
            return result.returncode
    return 0


def cmd_addon(args: argparse.Namespace) -> int:
    addon = args.addon
    if addon not in ("libndk", "libhoudini", "gapps"):
        return 1

    if not WAYDROID_CFG.is_file():
        print("Initializing Waydroid offline first...", flush=True)
        init_ns = argparse.Namespace(gpu="mesa", offline=True, gapps=False, force=False, drm_node="")
        if cmd_init(init_ns) != 0:
            return 1

    print(f"Stopping waydroid-container before installing {addon}...", flush=True)
    run_cmd(["systemctl", "stop", "waydroid-container.service"])
    try:
        with tempfile.TemporaryDirectory(prefix="tsukuyomi-wd-addon-") as tmp:
            repo_dir = Path(tmp) / "waydroid_script"
            print("Cloning casualsnek/waydroid_script...", flush=True)
            clone = run_cmd(
                ["git", "clone", "--depth", "1", "https://github.com/casualsnek/waydroid_script.git", str(repo_dir)],
                stream=True,
            )
            if clone.returncode != 0:
                return 1
            venv_dir = Path(tmp) / "venv"
            run_cmd([sys.executable, "-m", "venv", str(venv_dir)], check=True)
            pip_bin = str(venv_dir / "bin" / "pip")
            py_bin = str(venv_dir / "bin" / "python")
            req = repo_dir / "requirements.txt"
            if req.is_file():
                print("Installing waydroid_script Python dependencies...", flush=True)
                pip_res = run_cmd([pip_bin, "install", "--quiet", "-r", str(req)], stream=True)
                if pip_res.returncode != 0:
                    return 1
            print(f"Running waydroid_script -a 13 install {addon}...", flush=True)
            inst = run_cmd([py_bin, str(repo_dir / "main.py"), "-a", "13", "install", addon], stream=True)
            return inst.returncode
    finally:
        run_cmd(["systemctl", "start", "waydroid-container.service"])


def _update_fstab_bind(user: str, host_dl: Path, droid_dl: Path, enable: bool) -> None:
    if not FSTAB_PATH.is_file():
        return
    tag = f"# tsukuyomi-droid-shared-{user}"
    lines = FSTAB_PATH.read_text(encoding="utf-8").splitlines()
    filtered = [ln for ln in lines if tag not in ln]
    if enable:
        entry = (
            f"{host_dl} {droid_dl} none "
            f"bind,nofail,x-systemd.requires-mounts-for=/home/{user} 0 0 {tag}"
        )
        filtered.append(entry)
    FSTAB_PATH.write_text("\n".join(filtered) + "\n", encoding="utf-8")


def cmd_bind_shared(args: argparse.Namespace) -> int:
    user = args.user
    if not USER_RE.match(user) or user == "root":
        print(f"Invalid user: {user!r}", file=sys.stderr)
        return 1
    home = Path(f"/home/{user}")
    host_dl = home / "Downloads"
    if not host_dl.is_dir():
        return 1
    droid_dl = home / ".local" / "share" / "waydroid" / "data" / "media" / "0" / "Download"
    droid_dl.mkdir(parents=True, exist_ok=True)
    # Grant tight POSIX ACL to Android media_rw (UID 1023) + host user UID so both can read/write cleanly.
    if shutil.which("setfacl"):
        acl_spec = f"u:1023:rwx,u:{args.uid}:rwx"
        run_cmd(["setfacl", "-R", "-m", acl_spec, str(host_dl)])
        run_cmd(["setfacl", "-R", "-d", "-m", acl_spec, str(host_dl)])
    enable = args.enable == "true"
    if enable:
        mounted = run_cmd(["mountpoint", "-q", str(droid_dl)]).returncode == 0
        if not mounted:
            res = run_cmd(["mount", "--bind", str(host_dl), str(droid_dl)])
            if res.returncode != 0:
                sys.stderr.write(res.stderr)
                return res.returncode
    else:
        if run_cmd(["mountpoint", "-q", str(droid_dl)]).returncode == 0:
            run_cmd(["umount", str(droid_dl)])
    _update_fstab_bind(user, host_dl, droid_dl, enable)
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="droid-system-init")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init")
    p_init.add_argument("--gpu", choices=("mesa", "swiftshader"), default="mesa")
    p_init.add_argument("--drm-node", default="")
    p_init.add_argument("--viewport", nargs=2, type=int, metavar=("WIDTH", "HEIGHT"))
    p_init.add_argument("--offline", action="store_true")
    p_init.add_argument("--gapps", action="store_true")
    p_init.add_argument("--force", action="store_true")

    p_addon = sub.add_parser("addon")
    p_addon.add_argument("addon", choices=("libndk", "libhoudini", "gapps"))

    p_bind = sub.add_parser("bind-shared")
    p_bind.add_argument("--user", required=True)
    p_bind.add_argument("--uid", type=int, required=True)
    p_bind.add_argument("--enable", choices=("true", "false"), required=True)

    args = parser.parse_args(argv)
    if args.cmd == "init":
        if args.viewport and any(not 1 <= side <= 4096 for side in args.viewport):
            parser.error("Viewport dimensions must be between 1 and 4096.")
        return cmd_init(args)
    if args.cmd == "addon":
        return cmd_addon(args)
    if args.cmd == "bind-shared":
        return cmd_bind_shared(args)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
