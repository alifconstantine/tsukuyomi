#!/usr/bin/env bash
set -euo pipefail

pkg=${1:?package name required}
width=${2:-1280}
height=${3:-720}

cleanup() {
    waydroid session stop >/dev/null 2>&1 || true
}
trap cleanup EXIT

wait_boot() {
    local i=0
    while (( i < 40 )); do
        if waydroid status 2>/dev/null | grep -qE 'Session:[[:space:]]+RUNNING'; then
            if waydroid prop get sys.boot_completed 2>/dev/null | grep -q '1'; then
                return 0
            fi
        fi
        sleep 0.75
        i=$((i + 1))
    done
    return 1
}

# Start Waydroid session INSIDE gamescope's WAYLAND_DISPLAY so SurfaceFlinger renders inside gamescope!
waydroid session start >/dev/null 2>&1 &
wait_boot || true

cur_mw=$(waydroid prop get persist.waydroid.multi_windows 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
cur_w=$(waydroid prop get persist.waydroid.width 2>/dev/null | tr -d '[:space:]' || true)
cur_h=$(waydroid prop get persist.waydroid.height 2>/dev/null | tr -d '[:space:]' || true)
cur_ft=$(waydroid prop get persist.waydroid.fake_touch 2>/dev/null | tr -d '\r\n' || true)

need_restart=false
if [[ $cur_mw != *false* || $cur_w != "$width" || $cur_h != "$height" ]]; then
    need_restart=true
fi

waydroid prop set persist.waydroid.multi_windows false >/dev/null 2>&1 || true
waydroid prop set persist.waydroid.width "$width" >/dev/null 2>&1 || true
waydroid prop set persist.waydroid.height "$height" >/dev/null 2>&1 || true
if [[ $cur_ft != *"$pkg"* ]]; then
    if [[ -n $cur_ft && ${cur_ft,,} != *"not set"* ]]; then
        waydroid prop set persist.waydroid.fake_touch "${cur_ft},${pkg}.*" >/dev/null 2>&1 || true
    else
        waydroid prop set persist.waydroid.fake_touch "${pkg}.*" >/dev/null 2>&1 || true
    fi
fi

if $need_restart; then
    waydroid session stop >/dev/null 2>&1 || true
    sleep 1
    waydroid session start >/dev/null 2>&1 &
    wait_boot || true
fi

# Lock landscape orientation via targeted Waydroid ADB (non-root, never touches USB phones).
ip=$(waydroid status 2>/dev/null | awk '/IP address:/ {print $3; exit}' || true)
[[ -n $ip ]] || ip="192.168.240.112"
if command -v adb >/dev/null 2>&1; then
    adb connect "${ip}:5555" >/dev/null 2>&1 || true
    adb -s "${ip}:5555" shell wm user-rotation lock 1 >/dev/null 2>&1 || true
fi

waydroid app launch "$pkg" >/dev/null 2>&1 || true
waydroid show-full-ui
