#!/usr/bin/env bash
set -uo pipefail
export RYOKU_WM=hyprland XDG_CURRENT_DESKTOP=Hyprland
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for exports in "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share" /var/lib/flatpak/exports/share; do
    case ":$XDG_DATA_DIRS:" in
        *":$exports:"*) ;;
        *) XDG_DATA_DIRS="$XDG_DATA_DIRS:$exports" ;;
    esac
done

# Older releases copied the defaults into each home.
adopt_shipped_module() {
    local module=$1
    shift
    local module_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/modules"
    local current="$module_dir/$module.lua"
    local packaged="/usr/share/ryoku/config/hypr/modules/$module.lua"
    local sum expected pending

    [[ -f $current && ! -L $current && -r $packaged ]] || return 0
    sum=$(sha256sum < "$current") || return 0
    for expected in "$@"; do
        [[ ${sum%% *} == "$expected" ]] || continue
        if pending=$(mktemp -d -- "$module_dir/.$module.XXXXXXXX"); then
            ln -s -- "$packaged" "$pending/$module.lua" &&
                mv -fT -- "$pending/$module.lua" "$current"
            if [[ -L $pending/$module.lua ]]; then unlink -- "$pending/$module.lua"; fi
            rmdir -- "$pending"
        fi
        break
    done
}

adopt_shipped_module binds \
    0810666b0dd3d6edc18ae37aa5a6aef1c7eea1c13a28bb33f2a5f2a549ce0771 \
    84c08dc94e34e658f57c41ec8bd906714525dd5535c84f4b3effbf38feb7ddd7
adopt_shipped_module decoration \
    64b074c76027554c905a1fd507d6fe886c5bb2c880404624f098c12640a9d606
adopt_shipped_module perf_saver \
    40307993e7d722d3f2f27fc5c84e219ea172b60454f6399fe0921e1625b46df8 \
    57c742f6ab8246ea2df84034ee154284d806890b83de4c37073c6a928b767ca0
adopt_shipped_module window_rules \
    1d0443b2c32a540b7da535f63c3e91b6f32eb2d151641a2d97455f19d662c2c7 \
    a8cb66ae0c5a583509dfe84b0d77dacd4d2afc94a68f773d90de81f2da1e11ed \
    d04ff344e30adb5dbc3ea9fbca926e2c49c6e765499f5029e693d43447ac529d

migrate_browser_launch() {
    local config="${XDG_CONFIG_HOME:-$HOME/.config}/ryoku/desktop.json"
    local pending

    [[ -f $config && ! -L $config ]] || return 0
    jq -e '.desktop.apps.browser == "xdg-open about:blank"' "$config" >/dev/null 2>&1 || return 0
    pending=$(mktemp -- "${config}.XXXXXXXX") || return 0
    if jq --arg launch 'gtk-launch "$(xdg-settings get default-web-browser)"' \
        '.desktop.apps.browser = $launch' "$config" > "$pending"; then
        mv -fT -- "$pending" "$config"
    fi
    [[ ! -f $pending ]] || unlink -- "$pending"
}

migrate_browser_launch

seed_picker_defaults() {
    local config="${XDG_CONFIG_HOME:-$HOME/.config}/ryoku/ryogami.json"
    local pending

    [[ -f $config && ! -L $config ]] || return 0
    if jq -e '
        .selector.livePreview != null and .performance.maxThumbJobs != null
        and .transition.shader != null and .transition.durationMs != null and .transition.preview != null
        and (.selector.livePreview != false or .transition != {"shader":"crossfade","durationMs":200,"preview":false})
    ' "$config" >/dev/null 2>&1; then
        return 0
    fi

    pending=$(mktemp -- "${config}.XXXXXXXX") || return 0
    if jq '
        select(type == "object")
        | if (.selector.livePreview == false and .transition == {"shader":"crossfade","durationMs":200,"preview":false}) then
            .selector.livePreview = true
            | .transition = {"enabled": true, "family": "random", "shader": "random", "durationMs": 900, "preview": true}
          else
            .selector.livePreview //= true
            | .transition = ({"enabled": true, "family": "random", "shader": "random", "durationMs": 900, "preview": true} + (.transition // {}))
          end
        | .performance.maxThumbJobs //= 4
    ' "$config" > "$pending" && [[ -s $pending ]]; then
        mv -fT -- "$pending" "$config"
    fi
    [[ ! -f $pending ]] || unlink -- "$pending"
}

seed_picker_defaults

trap 'systemctl --user stop ryoku-session.target' EXIT
start-hyprland "$@"
