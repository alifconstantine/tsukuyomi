// Least-privilege Polkit rule for starting/stopping/restarting the Waydroid
// container service from a local active desktop session in group wheel.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "waydroid-container.service" &&
        (action.lookup("verb") === "start" ||
         action.lookup("verb") === "stop" ||
         action.lookup("verb") === "restart") &&
        subject.active &&
        subject.local &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
