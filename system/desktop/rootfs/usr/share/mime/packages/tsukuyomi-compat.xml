<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.tsukuyomi.xapk">
    <comment>Android Split APK Bundle (XAPK)</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="application-vnd.android.package-archive"/>
    <glob pattern="*.xapk"/>
  </mime-type>
  <mime-type type="application/vnd.tsukuyomi.apkm">
    <comment>Android Split APK Bundle (APKM)</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="application-vnd.android.package-archive"/>
    <glob pattern="*.apkm"/>
  </mime-type>
</mime-info>
